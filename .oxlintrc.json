{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.svelte-kit/**",
    "**/.astro/**",
    "apps/frontend/static/**",
    "apps/landing/static/**",
    "apps/docs/public/**",
    "apps/gateway/**",
    "apps/cli/**",
    "apps/r2-proxy/**",
    "apps/server/prisma/migrations/**",
    "apps/docs/openapi.generated.json",
    "apps/docs/src/content/docs/reference/**",
    "**/*.d.ts"
  ],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-param-reassign": ["error", { "props": false }],
    "no-void": ["error", { "allowAsStatement": true }],
    "unicorn/no-useless-spread": "off",
    "unicorn/no-useless-fallback-in-spread": "off"
  },
  "overrides": [
    {
      "files": ["apps/frontend/**", "apps/landing/**"],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["**/*.svelte", "**/*.svelte.ts", "**/*.svelte.js"],
      "rules": {
        "no-unused-expressions": "off"
      }
    },
    {
      "files": ["apps/server/src/sandboxes/sandbox-bootstrap.ts"],
      "rules": {
        "no-useless-escape": "off"
      }
    },
    {
      "files": [
        "apps/server/**",
        "packages/**",
        "scripts/**",
        "apps/docs/**",
        "apps/frontend/scripts/**"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": ["**/*.ts", "**/*.mts", "**/*.tsx"],
      "rules": {
        "no-use-before-define": ["error", { "functions": false }]
      }
    },
    {
      "files": ["apps/server/src/**/*.module.ts"],
      "rules": {
        "import/no-cycle": "off"
      }
    },
    {
      "files": ["apps/server/src/engine/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../*", "@nestjs/*", "@prisma/*"],
                "message": "engine/core stays standalone: only @kubernetes/client-node and files inside engine/core"
              }
            ]
          }
        ]
      }
    }
  ]
}
