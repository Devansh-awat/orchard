{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':semanticCommitTypeAll(chore)', 'helpers:pinGitHubActionDigests'],
  platformCommit: 'enabled',
  dependencyDashboardApproval: true,
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  labels: ['dependencies'],
  postUpdateOptions: ['gomodTidy', 'gomodUpdateImportPaths'],
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    dependencyDashboardApproval: false,
    semanticCommitType: 'fix',
    labels: ['dependencies', 'security'],
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: ['* * * * 1'],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile[^/]*$/'],
      matchStrings: ['corepack prepare pnpm@(?<currentValue>[0-9][^ ]*)'],
      depNameTemplate: 'pnpm',
      datasourceTemplate: 'npm',
    },
  ],
  packageRules: [
    {
      matchDatasources: ['npm', 'go'],
      minimumReleaseAge: '3 days',
    },
    {
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'npm minor and patch',
    },
    {
      matchManagers: ['gomod'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'go minor and patch',
    },
    {
      matchManagers: ['github-actions'],
      groupName: 'github actions',
    },
    {
      matchUpdateTypes: ['major'],
      addLabels: ['type/major'],
    },
    {
      matchUpdateTypes: ['minor'],
      addLabels: ['type/minor'],
    },
    {
      matchUpdateTypes: ['patch'],
      addLabels: ['type/patch'],
    },
    {
      matchUpdateTypes: ['digest', 'pin', 'pinDigest'],
      addLabels: ['type/digest'],
    },
    {
      matchPackageNames: ['pnpm'],
      groupName: 'pnpm',
    },
  ],
}
