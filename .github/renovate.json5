{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':semanticCommitTypeAll(chore)', 'helpers:pinGitHubActionDigests'],
  platformCommit: 'enabled',
  dependencyDashboardApproval: true,
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  labels: ['dependencies'],
  postUpdateOptions: ['gomodTidy', 'gomodUpdateImportPaths'],
  vulnerabilityAlerts: {
    dependencyDashboardApproval: false,
    labels: ['dependencies', 'security'],
  },
  packageRules: [
    {
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'npm minor and patch',
    },
    {
      matchManagers: ['gomod'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'go minor and patch',
    },
    {
      matchManagers: ['github-actions'],
      groupName: 'github actions',
    },
    {
      matchUpdateTypes: ['major'],
      addLabels: ['type/major'],
    },
    {
      matchUpdateTypes: ['minor'],
      addLabels: ['type/minor'],
    },
    {
      matchUpdateTypes: ['patch'],
      addLabels: ['type/patch'],
    },
    {
      matchUpdateTypes: ['digest', 'pin', 'pinDigest'],
      addLabels: ['type/digest'],
    },
  ],
}
