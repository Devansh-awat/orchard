{
  "name": "orchard",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm --parallel --stream --filter frontend --filter server --filter gateway dev",
    "dev:server": "pnpm --filter server dev",
    "dev:gateway": "pnpm --filter gateway dev",
    "build": "pnpm --parallel run build",
    "build:server": "pnpm --filter server build",
    "lint": "oxlint && node apps/frontend/scripts/check-design.mjs",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prisma:generate": "pnpm --filter server prisma:generate",
    "dev:docs": "pnpm --filter docs dev",
    "dev:landing": "pnpm --filter landing dev",
    "docs:generate": "pnpm --filter docs generate",
    "build:docs": "pnpm --filter docs build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0"
  }
}
