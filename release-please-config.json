{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "commit-search-depth": 50,
  "packages": {
    "apps/server": {
      "release-type": "node",
      "component": "server"
    },
    "apps/frontend": {
      "release-type": "node",
      "component": "frontend"
    },
    "apps/gateway": {
      "release-type": "go",
      "component": "gateway"
    },
    "apps/cli": {
      "release-type": "go",
      "component": "cli"
    },
    "apps/r2-proxy": {
      "release-type": "go",
      "component": "r2-proxy"
    }
  }
}
