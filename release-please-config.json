{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "commit-search-depth": 50,
  "packages": {
    "apps/server": {
      "release-type": "node",
      "component": "server"
    },
    "apps/frontend": {
      "release-type": "node",
      "component": "frontend"
    },
    "apps/gateway": {
      "release-type": "go",
      "component": "gateway"
    },
    "apps/cli": {
      "release-type": "go",
      "component": "cli"
    },
    "apps/r2-proxy": {
      "release-type": "go",
      "component": "r2-proxy"
    },
    "apps/fc-builder": {
      "release-type": "go",
      "component": "fc-builder"
    },
    "apps/registry": {
      "release-type": "go",
      "component": "registry"
    },
    "registry": {
      "release-type": "simple",
      "component": "templates"
    },
    "grafts/greenhouse": {
      "release-type": "node",
      "component": "greenhouse",
      "extra-files": [
        {
          "type": "json",
          "path": "graft.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "grafts/announcements": {
      "release-type": "node",
      "component": "announcements",
      "extra-files": [
        {
          "type": "json",
          "path": "graft.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "grafts/forum": {
      "release-type": "node",
      "component": "forum",
      "extra-files": [
        {
          "type": "json",
          "path": "graft.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "packages/graft-sdk": {
      "release-type": "node",
      "component": "graft-sdk"
    },
    "packages/graft-ui": {
      "release-type": "node",
      "component": "graft-ui"
    },
    "infra/images/sandbox": {
      "release-type": "simple",
      "component": "sandbox"
    }
  }
}
