{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "packages": {
    "server": { "release-type": "node", "component": "server" },
    "frontend": { "release-type": "node", "component": "frontend" },
    "gateway": { "release-type": "go", "component": "gateway" },
    "cli": { "release-type": "go", "component": "cli" },
    "r2-proxy": { "release-type": "go", "component": "r2-proxy" }
  }
}
