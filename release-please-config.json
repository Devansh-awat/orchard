{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "commit-search-depth": 50,
  "packages": {
    "apps/server": {
      "release-type": "node",
      "component": "server",
      "exclude-paths": [
        "apps/server/THIRD_PARTY_NOTICES.txt",
        "apps/server/hostctl/internal/notices/THIRD_PARTY_NOTICES.txt"
      ]
    },
    "apps/frontend": {
      "release-type": "node",
      "component": "frontend",
      "exclude-paths": ["apps/frontend/static/third-party-notices.txt"]
    },
    "apps/gateway": {
      "release-type": "go",
      "component": "gateway"
    },
    "apps/cli": {
      "release-type": "go",
      "component": "cli",
      "exclude-paths": [
        "apps/cli/internal/notices/THIRD_PARTY_NOTICES.txt",
        "apps/cli/tofu-provider/THIRD_PARTY_NOTICES.txt"
      ]
    },
    "apps/r2-proxy": {
      "release-type": "go",
      "component": "r2-proxy",
      "exclude-paths": ["apps/r2-proxy/THIRD_PARTY_NOTICES.txt"]
    },
    "apps/fc-builder": {
      "release-type": "go",
      "component": "fc-builder",
      "exclude-paths": ["apps/fc-builder/THIRD_PARTY_NOTICES.txt"]
    },
    "apps/registry": {
      "release-type": "go",
      "component": "registry",
      "exclude-paths": ["apps/registry/THIRD_PARTY_NOTICES.txt"]
    },
    "registry": {
      "release-type": "simple",
      "component": "templates"
    },
    "grafts/greenhouse": {
      "release-type": "node",
      "component": "greenhouse",
      "extra-files": [
        {
          "type": "json",
          "path": "graft.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "grafts/announcements": {
      "release-type": "node",
      "component": "announcements",
      "extra-files": [
        {
          "type": "json",
          "path": "graft.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "grafts/forum": {
      "release-type": "node",
      "component": "forum",
      "extra-files": [
        {
          "type": "json",
          "path": "graft.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "packages/graft-sdk": {
      "release-type": "node",
      "component": "graft-sdk"
    },
    "packages/graft-ui": {
      "release-type": "node",
      "component": "graft-ui"
    },
    "infra/images/sandbox": {
      "release-type": "simple",
      "component": "sandbox"
    },
    "releases/ui": {
      "release-type": "simple",
      "component": "ui"
    }
  }
}
