{
  "name": "@orchardlabs/graft-sdk",
  "version": "1.3.0",
  "license": "MIT",
  "description": "Build, pack and sign Orchard grafts (Orchard's extensions)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackclub/orchard.git",
    "directory": "packages/graft-sdk"
  },
  "homepage": "https://orchard.my/extensions",
  "type": "module",
  "files": [
    "bin",
    "cli",
    "src"
  ],
  "publishConfig": {
