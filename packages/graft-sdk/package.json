      "types": "./src/vite.d.ts",
      "default": "./src/vite.mjs"
    }
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@types/node": "^20.11.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "svelte": "^5.57.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "bin": {
    "graft": "bin/graft.mjs"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@swc/core": "^1.16.1",
    "esbuild": "^0.25.12",
    "vite": "^8.3.4"
  }
