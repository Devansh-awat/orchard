{
  "name": "@orchardlabs/graft-ui",
  "version": "1.0.0",
  "description": "Orchard's UI components and design tokens for graft screens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackclub/orchard.git",
    "directory": "packages/graft-ui"
  },
  "homepage": "https://orchard.my/extensions",
  "type": "module",
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "svelte": "./src/index.ts",
  "exports": {
