    },
    "./tokens.css": "./src/tokens.css",
    "./components/*": "./src/components/*",
    "./utils/*": "./src/utils/*.ts",
    "./stores/*": "./src/stores/*.ts"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "prepare": "node scripts/sync.mjs",
    "prepack": "node scripts/sync.mjs"
  },
  "dependencies": {
    "lucide-svelte": "^0.510.0",
    "melt": "^0.42.0",
    "@blobatar/svelte": "^2.7.0",
    "blobatar": "^2.7.0",
    "motion": "^12.38.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
