{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "builder": "swc",
    "typeCheck": false,
    "tsConfigPath": "tsconfig.json",
    "assets": [
      {
        "include": "templates/built-in/*.yaml",
        "watchAssets": true
      },
      {
        "include": "email/templates/*.mjml",
        "watchAssets": true
      }
    ]
  }
}
