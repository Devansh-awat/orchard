#!/usr/bin/env bash
set -euo pipefail
# Defaults that work unrendered, so this can be copied straight out of the
# image and run. install.sh writes the env file when paths differ.
: "${ORCHARD_STATE_DIR:=/etc/orchard}"
if [ -r "$ORCHARD_STATE_DIR/env" ]; then . "$ORCHARD_STATE_DIR/env"; fi
: "${ORCHARD_NAMESPACE:=orchard}"
: "${ORCHARD_BIN:=/usr/local/bin}"
export KUBECONFIG="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"

# The bootstrap, and the one host command that stays shell.
#
# install.sh fetches this file with `kubectl exec ... cat` before anything is
# installed, and an older host's copy of it is what pulls the first binary
# down, so it has to be readable as text and runnable with nothing else
# present. Everything else is orchardctl, which this installs.
BIN=$ORCHARD_BIN
TARGET="$BIN/orchardctl"
ALIASES="orchard-update orchard-config orchard-registry orchard-policies orchard-mcp orchard-public-ip orchard-claim orchard-hostname orchard-stop orchard-start orchard-restart orchard-login orchard-password orchard-graft orchard-k3s orchard-images orchard-uninstall"

case "$(uname -m)" in
  x86_64|amd64) ARCH=amd64 ;;
  aarch64|arm64) ARCH=arm64 ;;
  *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

if ! kubectl -n "$ORCHARD_NAMESPACE" exec deploy/server -- \
    cat "/app/hostbin/orchardctl-linux-$ARCH" > "$tmp" 2>/dev/null; then
  echo "could not read orchardctl-linux-$ARCH from the server image" >&2
  exit 1
fi

# Validated before it replaces anything: a truncated download would leave the
# operator with no way to upgrade or claim, which is the worst thing this
# script could do.
if [ ! -s "$tmp" ] || [ "$(wc -c < "$tmp")" -lt 1024 ]; then
  echo "refusing to install a truncated orchardctl" >&2
  exit 1
fi
if [ "$(head -c 4 "$tmp" | od -An -tx1 | tr -d ' \n')" != "7f454c46" ]; then
  echo "refusing to install orchardctl: not an ELF binary" >&2
  exit 1
fi

# Release signature, checked here as well as in orchardctl because this is what
# installs the first binary on a host. Needs an openssl with ed25519 -rawin;
# without one this warns, and orchardctl checks every later update itself.
RELEASE_KEYS=""
verify_release() {
  [ -n "$RELEASE_KEYS" ] || return 0
  [ "${ORCHARD_ALLOW_UNSIGNED_COMMANDS:-}" = true ] && return 0
  if ! openssl pkeyutl -help 2>&1 | grep -q rawin; then
    echo "warning: this openssl can't check release signatures" >&2
    return 0
  fi
  local dir key sum verified=false
  dir=$(mktemp -d)
  kubectl -n "$ORCHARD_NAMESPACE" exec deploy/server -- cat /app/hostbin/hostbin.manifest > "$dir/manifest" 2>/dev/null || true
  kubectl -n "$ORCHARD_NAMESPACE" exec deploy/server -- cat /app/hostbin/hostbin.sig 2>/dev/null | base64 -d > "$dir/sig" 2>/dev/null || true
  for key in $RELEASE_KEYS; do
    printf -- '-----BEGIN PUBLIC KEY-----\n%s\n-----END PUBLIC KEY-----\n' "$key" > "$dir/key.pem"
    if openssl pkeyutl -verify -pubin -inkey "$dir/key.pem" -rawin -in "$dir/manifest" -sigfile "$dir/sig" >/dev/null 2>&1; then
      verified=true
      break
    fi
  done
  if [ "$verified" != true ]; then
    rm -rf "$dir"
    echo "refusing to install orchardctl: the server image has no valid release signature" >&2
    echo "for an image you built yourself, set ORCHARD_ALLOW_UNSIGNED_COMMANDS=true in $ORCHARD_STATE_DIR/env" >&2
    return 1
  fi
  sum=$(sha256sum "$tmp" | cut -d' ' -f1)
  if ! grep -qx "sha256 $sum orchardctl-linux-$ARCH" "$dir/manifest"; then
    rm -rf "$dir"
    echo "refusing to install orchardctl: it does not match the signed release" >&2
    return 1
  fi
  rm -rf "$dir"
}
verify_release

if [ -f "$TARGET" ] && cmp -s "$tmp" "$TARGET"; then
  echo "host commands already current"
else
  # Written beside the target and renamed, so a failure part-way through leaves
  # the working copy in place rather than a half-written one.
  install -m 0755 "$tmp" "$TARGET.new"
  mv -f "$TARGET.new" "$TARGET"
  echo "updated orchardctl"
fi

# The hyphenated names are the same binary; it decides what to do from the name
# it was called by. Symlinks rather than copies so they cannot drift.
for name in $ALIASES; do
  ln -sf "$TARGET" "$BIN/$name"
done

exit 0
