#!/usr/bin/env bash
set -euo pipefail
# Defaults that work unrendered, so these can be copied straight out of the
# image and run. install.sh writes the env file when paths differ.
: "${ORCHARD_STATE_DIR:=/etc/orchard}"
if [ -r "$ORCHARD_STATE_DIR/env" ]; then . "$ORCHARD_STATE_DIR/env"; fi
: "${ORCHARD_VALUES:=$ORCHARD_STATE_DIR/values.yaml}"
: "${ORCHARD_CHART:=oci://ghcr.io/hackclub/orchard/charts/orchard}"
: "${ORCHARD_NAMESPACE:=orchard}"
: "${ORCHARD_BIN:=/usr/local/bin}"
export KUBECONFIG="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
VALUES=$ORCHARD_VALUES
PATH_KEY=.tenant.ingressNamespaces

usage() {
  cat <<'USAGE'
orchardctl policies - which namespaces may reach tenant apps

Every tenant namespace is default-deny, so the ingress controller has to be
named or it cannot reach the app. The symptom when it is wrong is not an
obviously dead site: it is a certificate that never issues, because the ACME
HTTP-01 solver is a pod in the tenant namespace and the controller cannot
reach it.

  orchardctl policies                     show the configured namespaces
  orchardctl policies set <ns>[,<ns>...]  change them
  orchardctl policies reapply             rewrite existing projects' policies

Changes only affect new projects until they are re-applied. `set` does that
for you once the new value is deployed; `reapply` on its own is for after an
upgrade.

  orchardctl policies set traefik,orchard --apply
USAGE
}

apply=false
args=()
for a in "$@"; do
  if [ "$a" = --apply ]; then apply=true; else args+=("$a"); fi
done
set -- ${args[@]+"${args[@]}"}

reapply() {
  # The server rewrites every managed namespace's policy on boot, so a restart
  # is the supported way to re-apply without a second code path that could
  # drift from the one that writes them.
  echo "restarting the server so it re-applies tenant policies..."
  kubectl -n "$ORCHARD_NAMESPACE" rollout restart deploy/server >/dev/null
  kubectl -n "$ORCHARD_NAMESPACE" rollout status deploy/server --timeout=5m
  echo "done. check one with:"
  echo "  kubectl -n <project-namespace> get networkpolicy default-deny-all -o yaml"
}

case "${1:-show}" in
  show)
    current=$(yq -r "$PATH_KEY // \"\"" "$VALUES" 2>/dev/null || echo "")
    if [ -z "$current" ] || [ "$current" = "null" ]; then
      echo "Not set, so the default applies: network,orchard"
      echo "That is where this project runs HAProxy. On k3s with Traefik, run:"
      echo "  orchardctl policies set traefik,orchard --apply"
    else
      echo "$current"
    fi
    ;;
  set)
    [ $# -eq 2 ] || { usage; exit 1; }
    ORCHARD_NS_LIST="$2" yq -i "$PATH_KEY = env(ORCHARD_NS_LIST)" "$VALUES"
    echo "tenant.ingressNamespaces = $2"
    if [ "$apply" = true ]; then
      orchard-update
      reapply
    else
      echo "not deployed yet: run orchardctl update, then orchardctl policies reapply"
    fi
    exit 0
    ;;
  reapply)
    reapply
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    usage
    exit 1
    ;;
esac

if [ "$apply" = true ]; then
  exec orchard-update
fi
