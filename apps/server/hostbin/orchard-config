#!/usr/bin/env bash
set -euo pipefail
# Defaults that work unrendered, so these can be copied straight out of the
# image and run. install.sh writes the env file when paths differ.
: "${ORCHARD_STATE_DIR:=/etc/orchard}"
if [ -r "$ORCHARD_STATE_DIR/env" ]; then . "$ORCHARD_STATE_DIR/env"; fi
: "${ORCHARD_VALUES:=$ORCHARD_STATE_DIR/values.yaml}"
: "${ORCHARD_CHART:=oci://ghcr.io/hackclub/orchard/charts/orchard}"
: "${ORCHARD_NAMESPACE:=orchard}"
: "${ORCHARD_BIN:=/usr/local/bin}"
export KUBECONFIG="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
VALUES=$ORCHARD_VALUES

usage() {
  cat <<'USAGE'
orchardctl config - read and change this instance's chart values

  orchardctl config get <path>          print one value
  orchardctl config set <path> <value>  change one value
  orchardctl config unset <path>        remove one value
  orchardctl config list                print the whole values file
  orchardctl config edit                open it in $EDITOR

Paths are dotted, e.g. signupMode or ingress.tls.issuerRef.name.
Changes are written but not deployed. Add --apply to run orchard-update
afterwards, or run it yourself once you have made every edit.

Common ones:
  signupMode                     open | invite_only | closed
  tenant.certClusterIssuer       ClusterIssuer for user app certificates
  ingress.tls.issuerRef.name     ClusterIssuer for the Orchard UI itself
  metrics.enabled                the built-in metrics stack
  cilium.enabled                 Cilium-backed policy and basic auth
  protection.orchardLogin        offer "sign in with Orchard" on tenant hosts
  server.replicas                control-plane API pods
USAGE
}

apply=false
args=()
for a in "$@"; do
  if [ "$a" = --apply ]; then apply=true; else args+=("$a"); fi
done
set -- ${args[@]+"${args[@]}"}

[ $# -ge 1 ] || { usage; exit 1; }

case "$1" in
  get)
    [ $# -eq 2 ] || { usage; exit 1; }
    yq ".$2" "$VALUES"
    ;;
  list)
    cat "$VALUES"
    ;;
  edit)
    "${EDITOR:-vi}" "$VALUES"
    ;;
  unset)
    [ $# -eq 2 ] || { usage; exit 1; }
    yq -i "del(.$2)" "$VALUES"
    echo "unset $2"
    ;;
  set)
    [ $# -eq 3 ] || { usage; exit 1; }
    # env() parses the value as YAML, so true/false and numbers keep their own
    # type while a bare word stays a string. Interpolating it into the
    # expression instead would make yq try to lex `invite_only` as syntax.
    ORCHARD_CONFIG_VALUE="$3" yq -i ".$2 = env(ORCHARD_CONFIG_VALUE)" "$VALUES"
    echo "$2 = $(yq ".$2" "$VALUES")"
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    usage
    exit 1
    ;;
esac

if [ "$apply" = true ]; then
  exec orchard-update
fi
