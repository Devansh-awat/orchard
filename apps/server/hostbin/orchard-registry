#!/usr/bin/env bash
set -euo pipefail
# Defaults that work unrendered, so these can be copied straight out of the
# image and run. install.sh writes the env file when paths differ.
: "${ORCHARD_STATE_DIR:=/etc/orchard}"
if [ -r "$ORCHARD_STATE_DIR/env" ]; then . "$ORCHARD_STATE_DIR/env"; fi
: "${ORCHARD_VALUES:=$ORCHARD_STATE_DIR/values.yaml}"
: "${ORCHARD_CHART:=oci://ghcr.io/hackclub/orchard/charts/orchard}"
: "${ORCHARD_NAMESPACE:=orchard}"
: "${ORCHARD_BIN:=/usr/local/bin}"
export KUBECONFIG="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
VALUES=$ORCHARD_VALUES
EGRESS=.builders.registryEgress

usage() {
  cat <<'USAGE'
orchardctl registry - where builds are allowed to push

Builds run firewalled off from the rest of the cluster, so the registry they
push to has to be named here or the push is refused after a successful build.

  orchardctl registry                        show the current destinations
  orchardctl registry allow <ns> [options]   add one
  orchardctl registry remove <ns>            drop one
  orchardctl registry zot                    the registry this installer ships

Options for allow:
  --label <k=v>    only pods carrying this label, repeatable
  --port <n>       only this port, repeatable

Changes are written but not deployed. Add --apply to run orchard-update
afterwards, or run it yourself once you have made every edit.

  orchardctl registry zot --apply
  orchardctl registry allow my-registry --label app=registry --port 5000
USAGE
}

apply=false
args=()
for a in "$@"; do
  if [ "$a" = --apply ]; then apply=true; else args+=("$a"); fi
done
set -- ${args[@]+"${args[@]}"}

show() {
  if [ "$(yq "$EGRESS // \"\"" "$VALUES")" = "" ]; then
    echo "No destinations set, so the chart's defaults apply:"
    echo "  harbor, and the ingress controller in the network namespace."
    echo "Neither exists on a single-node install. Run: orchardctl registry zot"
    return
  fi
  yq "$EGRESS" "$VALUES"
}

add() {
  ns=$1; shift
  labels=(); ports=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --label) [ $# -ge 2 ] || { usage; exit 1; }; labels+=("$2"); shift 2 ;;
      --port)  [ $# -ge 2 ] || { usage; exit 1; }; ports+=("$2"); shift 2 ;;
      *) echo "unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
  done

  # Replace rather than append when the namespace is already listed, so running
  # this twice does not leave two rules that have to be reconciled by hand.
  ORCHARD_NS="$ns" yq -i "$EGRESS = [($EGRESS // [])[] | select(.namespace != env(ORCHARD_NS))]" "$VALUES"
  ORCHARD_NS="$ns" yq -i "$EGRESS += [{\"namespace\": env(ORCHARD_NS)}]" "$VALUES"

  for l in ${labels[@]+"${labels[@]}"}; do
    k=${l%%=*}; v=${l#*=}
    [ "$k" != "$l" ] || { echo "labels look like key=value: $l" >&2; exit 1; }
    ORCHARD_NS="$ns" ORCHARD_LK="$k" ORCHARD_LV="$v" yq -i \
      "($EGRESS[] | select(.namespace == env(ORCHARD_NS)) | .podLabels[env(ORCHARD_LK)]) = env(ORCHARD_LV)" "$VALUES"
  done

  for p in ${ports[@]+"${ports[@]}"}; do
    ORCHARD_NS="$ns" ORCHARD_PORT="$p" yq -i \
      "($EGRESS[] | select(.namespace == env(ORCHARD_NS)) | .ports) += [{\"port\": env(ORCHARD_PORT)}]" "$VALUES"
  done

  echo "builds may now push to:"
  ORCHARD_NS="$ns" yq "$EGRESS[] | select(.namespace == env(ORCHARD_NS))" "$VALUES"
}

[ $# -ge 1 ] || { show; exit 0; }

case "$1" in
  show)
    show
    ;;
  zot)
    # What install.sh deploys: zot in the release namespace on 5000.
    add "$ORCHARD_NAMESPACE" --label app=zot --port 5000
    ;;
  allow)
    [ $# -ge 2 ] || { usage; exit 1; }
    shift
    add "$@"
    ;;
  remove)
    [ $# -eq 2 ] || { usage; exit 1; }
    ORCHARD_NS="$2" yq -i "$EGRESS = [($EGRESS // [])[] | select(.namespace != env(ORCHARD_NS))]" "$VALUES"
    echo "removed $2"
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    usage
    exit 1
    ;;
esac

if [ "$apply" = true ]; then
  exec orchard-update
fi
