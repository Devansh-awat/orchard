<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all
        font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
      />
      <mj-text font-size="15px" color="#3f3f46" line-height="160%" padding="0" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style>
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('{{assetBaseUrl}}/fonts/Plus_Jakarta_Sans/PlusJakartaSans-VariableFont_wght.ttf')
          format('truetype');
        font-weight: 200 800;
        font-style: normal;
      }
    </mj-style>
    <mj-style>
      .otp-code {
        font-family: 'Space Mono', 'SF Mono', 'Fira Code', 'Courier New', monospace;
        font-size: 32px;
        font-weight: 700;
        letter-spacing: 10px;
        color: #962b3a;
        background-color: #fef5f6;
        border: 1px solid #f9d1d6;
        padding: 14px 28px;
        border-radius: 10px;
        display: inline-block;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#fafafa" width="520px">
    <mj-section padding="40px 0 24px 0">
      <mj-column>
        <mj-image
          src="{{frontendUrl}}/logo/logocolor.svg"
          alt="Orchard"
          width="140px"
          padding="0"
        />
      </mj-column>
    </mj-section>

    <mj-section
      background-color="#ffffff"
      border-radius="12px"
      padding="40px 36px 36px 36px"
      border="1px solid #e4e4e7"
    >
      <mj-column>
        <mj-text
          align="center"
          font-size="22px"
          font-weight="600"
          color="#18181b"
          letter-spacing="-0.5px"
          padding-bottom="8px"
        >
          Your verification code
        </mj-text>

        <mj-text align="center" font-size="15px" color="#71717a" padding-bottom="28px">
          Enter this code to sign in to your Orchard account.
        </mj-text>

        <mj-text align="center" padding-bottom="28px">
          <div class="otp-code">{{ otpCode }}</div>
        </mj-text>

        <mj-text align="center" font-size="13px" color="#71717a" padding-bottom="24px">
          This code expires in <strong style="color: #18181b">{{ expiryMinutes }} minutes</strong>.
        </mj-text>

        <mj-divider border-color="#e4e4e7" border-width="1px" padding="0 0 24px 0" />

        <mj-text font-size="13px" color="#71717a" line-height="150%">
          <strong style="color: #3f3f46">Security tip:</strong> Never share this code with anyone.
          Orchard will never ask for this code via phone, text, or another email.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 0 40px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#a1a1aa">
          Sent to {{ recipientEmail }}. If you didn't request this code, you can safely ignore this
          email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
