<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="15px" color="#3f3f46" line-height="160%" padding="0" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style>
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('{{assetBaseUrl}}/fonts/Plus_Jakarta_Sans/PlusJakartaSans-VariableFont_wght.ttf') format('truetype');
        font-weight: 200 800;
        font-style: normal;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#fafafa" width="520px">
    <mj-section padding="40px 0 24px 0">
      <mj-column>
        <mj-image src="{{frontendUrl}}/logo/logocolor.svg" alt="Orchard" width="140px" padding="0" />
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="12px" padding="40px 36px 36px 36px" border="1px solid #e4e4e7">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="600" color="#18181b" letter-spacing="-0.5px" padding-bottom="8px">
          You've been invited
        </mj-text>

        <mj-text align="center" font-size="15px" color="#71717a" padding-bottom="28px">
          {{inviterName}} invited you to join <strong style="color: #18181b;">{{organizationName}}</strong> on Orchard.
        </mj-text>

        <mj-button background-color="#b33346" border-radius="8px" font-size="15px" font-weight="600" color="#ffffff" href="{{loginUrl}}" padding="0 0 28px 0" inner-padding="12px 28px" font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">
          Login Here
        </mj-button>

        <mj-divider border-color="#e4e4e7" border-width="1px" padding="0 0 20px 0" />

        <mj-table font-size="14px" color="#3f3f46" cellpadding="6">
          <tr>
            <td style="color: #71717a; padding: 6px 0;">Organization</td>
            <td style="text-align: right; font-weight: 600; padding: 6px 0;">{{organizationName}}</td>
          </tr>
          <tr>
            <td style="color: #71717a; padding: 6px 0;">Your Role</td>
            <td style="text-align: right; font-weight: 600; padding: 6px 0;">{{role}}</td>
          </tr>
          <tr>
            <td style="color: #71717a; padding: 6px 0;">Invited By</td>
            <td style="text-align: right; font-weight: 600; padding: 6px 0;">{{inviterName}}</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 0 40px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#a1a1aa">
          Sent to {{recipientEmail}}. This invitation expires in 7 days.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
