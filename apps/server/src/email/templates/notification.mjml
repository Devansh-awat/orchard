<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="15px" color="#3f3f46" line-height="160%" padding="0" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style>
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('{{assetBaseUrl}}/fonts/Plus_Jakarta_Sans/PlusJakartaSans-VariableFont_wght.ttf') format('truetype');
        font-weight: 200 800;
        font-style: normal;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#fafafa" width="520px">
    <mj-section padding="40px 0 24px 0">
      <mj-column>
        <mj-image src="{{frontendUrl}}/logo/logocolor.svg" alt="Orchard" width="140px" padding="0" />
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="12px" padding="40px 36px 36px 36px" border="1px solid #e4e4e7">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="600" color="#18181b" letter-spacing="-0.5px" padding-bottom="8px">
          {{title}}
        </mj-text>

        <mj-text align="center" font-size="15px" color="#71717a" padding-bottom="8px">
          {{body}}
        </mj-text>

        <mj-text align="center" font-size="13px" color="#a1a1aa" padding-bottom="28px">
          {{contextLine}}
        </mj-text>

        <mj-button href="{{ctaUrl}}" background-color="#962b3a" color="#ffffff" border-radius="10px" font-size="15px" font-weight="600" inner-padding="12px 28px">
          View in Orchard
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 0 40px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#a1a1aa">
          You're receiving this because a notification channel is configured for your organization on Orchard.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
