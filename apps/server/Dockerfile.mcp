# syntax=docker/dockerfile:1
# Build from the project root: docker build -f apps/server/Dockerfile.mcp -t orchard-mcp .
# Requires BuildKit. On Docker 23+ this is on by default; otherwise set DOCKER_BUILDKIT=1.

FROM node:22.23.5-alpine AS base

RUN apk add --no-cache openssl ca-certificates

RUN corepack enable && corepack prepare pnpm@11.11.0 --activate

FROM base AS deps
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/server/package.json ./apps/server/

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/server/node_modules ./apps/server/node_modules
COPY apps/server ./apps/server
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./

WORKDIR /app/apps/server
RUN pnpm prisma:generate
RUN pnpm build

FROM base AS runner
LABEL org.opencontainers.image.source="https://github.com/hackclub/orchard"
WORKDIR /app

ENV NODE_ENV=production

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY --from=builder /app/apps/server/package.json ./apps/server/package.json
COPY --from=builder /app/apps/server/dist ./apps/server/dist
COPY --from=builder /app/apps/server/prisma ./apps/server/prisma
COPY packages/contracts/agent-spec.json ./packages/contracts/
COPY LICENSE apps/server/THIRD_PARTY_NOTICES.txt /app/

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prod --filter server

WORKDIR /app/apps/server
RUN node_modules/.bin/prisma generate \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
              /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
              /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
              /root/.cache/node /root/.local/share/pnpm

EXPOSE 3100

CMD ["node", "dist/mcp/main.js"]
