// One row per build attempt (auto-deploy push, manual deploy, or rebuild).
// The queue's source of truth: a distributed SKIP LOCKED claimer promotes
// `scheduled` rows to `building` while respecting a global concurrency cap and
// one-active-build-per-deployment. Newer scheduled runs coalesce older ones to
// `skipped`. Heartbeats let a stale-worker sweep reclaim orphaned `building`
// runs. See BuildQueueService.
model BuildRun {
  id           String @id @default(uuid()) @db.Uuid
  deploymentId String @map("deployment_id") @db.Uuid
  // scheduled | building | succeeded | failed | skipped | canceled
  status       String @default("scheduled") @db.VarChar(20)
  // auto | manual | rebuild
  triggerType  String @map("trigger_type") @db.VarChar(20)

  commitSha            String? @map("commit_sha") @db.VarChar(255)
  commitMessage        String? @map("commit_message") @db.Text
  commitAuthorName     String? @map("commit_author_name") @db.VarChar(255)
  commitAuthorUsername String? @map("commit_author_username") @db.VarChar(255)
  branch               String? @db.VarChar(255)

  triggeredById String? @map("triggered_by_id") @db.Uuid

  // Which server process claimed this run, plus a liveness heartbeat. If the
  // heartbeat goes stale the reclaim sweep fails the run and frees its slot.
  workerId    String?   @map("worker_id") @db.VarChar(120)
  heartbeatAt DateTime? @map("heartbeat_at") @db.Timestamp(6)

  // GitHub artifacts opened for this run, so the reclaim sweep can close
  // them when the owning process dies mid-build.
  checkRunId           BigInt? @map("check_run_id")
  githubInstallationId BigInt? @map("github_installation_id")
  repoFullName         String? @map("repo_full_name") @db.VarChar(255)

  // Failure message, or the reason a run was skipped/canceled.
  detail String? @db.Text

  logs String? @db.Text

  scheduledAt DateTime  @default(now()) @map("scheduled_at") @db.Timestamp(6)
  startedAt   DateTime? @map("started_at") @db.Timestamp(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  deployment  Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  triggeredBy User?      @relation("BuildRunTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt], map: "idx_build_runs_claim")
  @@index([deploymentId, status], map: "idx_build_runs_deployment_status")
  @@index([deploymentId, createdAt(sort: Desc)], map: "idx_build_runs_deployment_recent")
  @@index([status, heartbeatAt], map: "idx_build_runs_reclaim")
  @@map("build_runs")
}

model DeploymentWebhookToken {
  id                String    @id @default(uuid()) @db.Uuid
  deploymentId      String    @map("deployment_id") @db.Uuid
  // Legacy plaintext column. Kept nullable for rollback safety; new rows
  // write NULL here, old rows are nulled by the 20260515180000 migration
  // after their hash is backfilled. New code must look up by `tokenHash`.
  token             String?   @unique @db.VarChar(128)
  // SHA-256 hex digest of the plaintext token. Webhook tokens are bearer
  // secrets — storing them in plaintext turned a DB-read foothold (backup
  // leak, replica access) into working triggers.
  tokenHash         String    @unique @map("token_hash") @db.VarChar(128)
  label             String?   @db.VarChar(100)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamp(6)
  createdByUserId   String?   @map("created_by_user_id") @db.Uuid
  // H-3: when a webhook is minted via an API token (vs a session), record
  // which API token authored it. Revoking the parent API token must also
  // kill any webhooks created with it, otherwise a project-scoped token's
  // deployment-trigger capability outlives the token itself.
  originatingApiTokenId String? @map("originating_api_token_id") @db.Uuid

  deployment            Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  createdByUser         User?      @relation("WebhookTokenCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  originatingApiToken   ApiToken?  @relation("WebhookTokenOriginatingApiToken", fields: [originatingApiTokenId], references: [id], onDelete: Cascade)

  @@index([deploymentId], map: "idx_webhook_tokens_deployment")
  @@index([originatingApiTokenId], map: "idx_webhook_tokens_originating_api_token")
  @@map("deployment_webhook_tokens")
}

