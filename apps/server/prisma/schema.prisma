  importBoosted     Boolean  @default(false) @map("import_boosted")
  publicEnabled      Boolean  @default(false) @map("public_enabled")
  publicIp           String?  @map("public_ip") @db.VarChar(45)
  publicPort         Int?     @map("public_port")
  cpuRequestMilli    Int?     @map("cpu_request_milli")
