---
import CopyPromptButton from '../CopyPromptButton.astro';
import CornerMarks from '../CornerMarks.astro';
import Icon from '../Icon.astro';
import { AGENT_PANEL } from '../../lib/home';
import { INSTALL_PROMPT } from '../../lib/nav';
---

<section class="agent-panel not-content" aria-labelledby="agent-heading">
  <CornerMarks />
  <div class="main">
    <h2 id="agent-heading">{AGENT_PANEL.heading}</h2>
    <p>{AGENT_PANEL.text}</p>
    <blockquote>{INSTALL_PROMPT}</blockquote>
    <CopyPromptButton />
  </div>
  <div class="side">
    <div class="o-dots side-dots" aria-hidden="true"></div>
    <h3>{AGENT_PANEL.sideHeading}</h3>
    <a class="o-btn o-btn-primary o-btn-sm" href="/agent-setup/">
      {AGENT_PANEL.sideLink}
      <Icon name="arrow-right" size={14} />
    </a>
  </div>
</section>

<style>
  .agent-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border: 1px solid color-mix(in srgb, var(--o-accent) 40%, transparent);
    background: color-mix(in srgb, var(--o-accent) 4%, var(--o-raised));
  }

  .main {
    min-width: 0;
    padding: 1.5rem 1.25rem;
  }

  h2 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(1.5rem, 1.3rem + 0.9vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  p {
    margin: 0.625rem 0 0;
    color: var(--sl-color-gray-2);
  }

  blockquote {
    max-width: 44rem;
    margin: 1rem 0 1.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--o-rule);
    border-radius: 0.375rem;
    background: var(--o-code);
    color: var(--sl-color-gray-1);
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .side {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
    overflow: hidden;
    border-top: 1px solid color-mix(in srgb, var(--o-accent) 40%, transparent);
  }

  .side-dots {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    mask-image: linear-gradient(to top, black, transparent 70%);
  }

  h3 {
    position: relative;
    max-width: 14ch;
    margin: 0;
    color: var(--sl-color-white);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .side .o-btn {
    position: relative;
  }

  @media (min-width: 72rem) {
    .agent-panel {
      grid-template-columns: minmax(0, 1fr) 19rem;
    }

    .main {
      padding: 2rem;
    }

    .side {
      flex-direction: column;
      align-items: stretch;
      padding: 2rem;
      border-top: 0;
      border-inline-start: 1px solid color-mix(in srgb, var(--o-accent) 40%, transparent);
    }

    .side .o-btn {
      align-self: flex-end;
    }
  }
</style>
