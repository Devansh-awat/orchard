---
import CopyPromptButton from '../CopyPromptButton.astro';
import Icon from '../Icon.astro';
import { AGENT_PANEL } from '../../lib/home';
import { INSTALL_PROMPT } from '../../lib/nav';
---

<section class="agent-panel not-content" aria-labelledby="agent-heading">
  <div class="main">
    <h2 id="agent-heading">{AGENT_PANEL.heading}</h2>
    <p>{AGENT_PANEL.text}</p>
    <blockquote>{INSTALL_PROMPT}</blockquote>
    <CopyPromptButton prompt={INSTALL_PROMPT} preview={false} />
  </div>
  <div class="side">
    <h3>{AGENT_PANEL.sideHeading}</h3>
    <a class="o-btn o-btn-primary o-btn-sm" href="/agent-setup/">
      {AGENT_PANEL.sideLink}
      <Icon name="arrow-right" size={14} />
    </a>
  </div>
</section>

<style>
  .agent-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.25rem;
    border-radius: var(--o-widget-r);
    corner-shape: var(--corner);
    background: var(--bg-surface);
    box-shadow: var(--shadow-raised);
  }

  .main {
    min-width: 0;
  }

  h2 {
    margin: 0;
    color: var(--text-default);
    font-size: var(--text-title-2);
    font-weight: var(--weight-medium);
    line-height: var(--lh-title-2);
  }

  p {
    margin: 0.25rem 0 0;
    color: var(--text-muted);
    font-size: var(--text-body);
    line-height: var(--lh-body);
  }

  blockquote {
    margin: 0.75rem 0;
    padding: 0.75rem 0.875rem;
    border: 0;
    border-radius: var(--o-card-r);
    corner-shape: var(--corner);
    background: var(--bg-sunken);
    color: var(--text-default);
    font-family: var(--sl-font-mono);
    font-size: var(--text-caption);
    line-height: 1.5;
  }

  .side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.75rem;
  }

  h3 {
    margin: 0;
    color: var(--text-default);
    font-size: var(--text-headline);
    font-weight: var(--weight-medium);
    line-height: var(--lh-headline);
  }

  @media (min-width: 56rem) {
    .agent-panel {
      grid-template-columns: minmax(0, 1.618fr) minmax(0, 1fr);
      align-items: center;
    }
  }
</style>
