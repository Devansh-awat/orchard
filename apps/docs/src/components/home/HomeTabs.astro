---
import Command from '../Command.astro';
import CornerMarks from '../CornerMarks.astro';
import Icon from '../Icon.astro';
import Infographic from './Infographic.astro';
import { homeTabs } from '../../lib/home';
---

<div class="tabs not-content" data-tabs>
  <CornerMarks />
  <div class="tablist" role="tablist" aria-label="Orchard features">
    {
      homeTabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  {
    homeTabs.map((tab, index) => (
      <section
        class="panel"
        role="tabpanel"
        id={`panel-${tab.id}`}
        aria-labelledby={`tab-${tab.id}`}
        tabindex="0"
        hidden={index !== 0}
      >
        <div class="body">
          <h3>
            <span class="glyph">
              <Icon name={tab.icon} size={18} />
            </span>
            {tab.heading}
          </h3>
          <p>{tab.text}</p>
          <div class="command">
            <Command code={tab.command} />
          </div>
          <div class="links">
            <a class="o-btn o-btn-outline o-btn-sm" href={tab.primary.href}>
              {tab.primary.label}
              <Icon name="arrow-right" size={14} />
            </a>
            <ul>
              {tab.related.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="figure">
          <Infographic kind={tab.id} />
        </div>
      </section>
    ))
  }
</div>

<noscript>
  <style>
    [data-tabs] .panel[hidden] {
      display: grid;
    }
    [data-tabs] .tablist {
      display: none;
    }
  </style>
</noscript>

<script>
  import { bindTabs } from '../../lib/client/tabs';

  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(bindTabs);
</script>

<style>
  .tabs {
    position: relative;
    border: 1px solid var(--o-rule);
    background: var(--o-raised);
  }

  .tablist {
    display: flex;
    overflow-x: auto;
    border-bottom: 1px solid var(--o-rule);
    scrollbar-width: none;
  }

  [role='tab'] {
    flex: none;
    padding: 0.8125rem 1.25rem;
    border: 0;
    border-inline-end: 1px solid var(--o-rule);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }

  [role='tab']:hover {
    color: var(--sl-color-white);
  }

  [role='tab'][aria-selected='true'] {
    border-bottom-color: var(--o-accent);
    background: var(--o-canvas);
    color: var(--sl-color-white);
  }

  [role='tab']:focus-visible {
    outline-offset: -2px;
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .panel[hidden] {
    display: none;
  }

  .panel:focus-visible {
    outline-offset: -2px;
  }

  .body {
    min-width: 0;
    padding: 1.5rem 1.25rem;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    color: var(--sl-color-white);
    font-size: 1.1875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .glyph {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px dashed color-mix(in srgb, var(--o-accent-text) 70%, transparent);
    border-radius: 0.25rem;
    background: var(--o-accent-tint);
    color: var(--o-accent-text);
  }

  p {
    max-width: 44rem;
    margin: 0.875rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: 1rem;
    line-height: 1.65;
  }

  .command {
    max-width: 42rem;
    margin-top: 1.25rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem 1.5rem;
    margin-top: 1.5rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    color: var(--sl-color-gray-1);
    font-size: 0.875rem;
    text-decoration: none;
  }

  ul a:hover {
    color: var(--o-accent-text);
  }

  .figure {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    border-top: 1px solid var(--o-rule);
    background: var(--o-canvas);
  }

  @media (min-width: 72rem) {
    .panel {
      grid-template-columns: minmax(0, 1fr) 19rem;
    }

    .body {
      padding: 2rem;
    }

    .figure {
      border-top: 0;
      border-inline-start: 1px solid var(--o-rule);
    }
  }
</style>
