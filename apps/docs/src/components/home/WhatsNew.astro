---
import Icon from '../Icon.astro';
import { changeHref, formatDate, getFeatured } from '../../lib/changelog';
import { WHATS_NEW } from '../../lib/home';

const featured = getFeatured(6);
---

{
  featured.length > 0 && (
    <section class="whats-new not-content" aria-labelledby="new-heading">
      <div class="head">
        <h2 id="new-heading">{WHATS_NEW.heading}</h2>
        <a class="o-btn o-btn-outline o-btn-sm" href="/changelog/">
          {WHATS_NEW.link}
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
      <ul>
        {featured.map((change) => (
          <li>
            <a href={changeHref(change)}>
              <span class="text">{change.text}</span>
              <span class="o-label">{change.component}</span>
              <time datetime={change.date}>{formatDate(change.date, false)}</time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  h2 {
    margin: 0;
    color: var(--text-default);
    font-size: var(--text-title-2);
    font-weight: var(--weight-medium);
    line-height: var(--lh-title-2);
  }

  ul {
    margin: 0;
    padding: 0.375rem;
    border-radius: var(--o-widget-r);
    corner-shape: var(--corner);
    background: var(--bg-surface);
    box-shadow: var(--shadow-raised);
    list-style: none;
  }

  a:not(.o-btn) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 3.5rem;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 0.625rem;
    border-radius: var(--o-card-r);
    corner-shape: var(--corner);
    color: var(--text-default);
    font-size: var(--text-body);
    line-height: var(--lh-body);
    text-decoration: none;
  }

  a:not(.o-btn):hover {
    background: color-mix(in oklab, var(--neutral-10) 6%, transparent);
  }

  time {
    color: var(--text-faint);
    font-size: var(--text-caption);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }
</style>
