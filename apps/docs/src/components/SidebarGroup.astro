---
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';
import Icon from './Icon.astro';
import { groupIcons } from '../lib/nav';
import type { IconName } from '../lib/icons';

type SidebarEntry = NonNullable<App.Locals['starlightRoute']>['sidebar'][number];

interface Props {
  entries: SidebarEntry[];
  depth: number;
  path: string;
  icon?: IconName;
}

const { entries, depth, path, icon } = Astro.props;

function containsCurrent(entry: SidebarEntry): boolean {
  if (entry.type === 'link') return isCurrent(entry);
  return entry.entries.some(containsCurrent);
}

function isCurrent(entry: Extract<SidebarEntry, { type: 'link' }>): boolean {
  if (entry.isCurrent) return true;
  return entry.href === '/changelog/' && path.startsWith('/changelog/');
}
---

<ul class:list={['list', `depth-${depth}`]}>
  {
    entries.map((entry) => {
      const entryIcon = icon ?? (depth === 1 ? groupIcons[entry.label] : undefined);
      return (
        <li>
          {entry.type === 'link' ? (
            <a
              href={entry.href}
              aria-current={isCurrent(entry) ? 'page' : undefined}
              class:list={['item', entry.attrs.class]}
            >
              {entryIcon && <Icon name={entryIcon} class="icon" />}
              <span class="text">{entry.label}</span>
              {entry.badge && (
                <span class:list={['badge', entry.badge.class, `badge-${entry.badge.variant}`]}>
                  {entry.badge.text}
                </span>
              )}
            </a>
          ) : (
            <details open={containsCurrent(entry) || !entry.collapsed}>
              <summary class="item">
                {entryIcon && <Icon name={entryIcon} class="icon" />}
                <span class="text">{entry.label}</span>
                <Icon name="chevron-right" class="caret" />
              </summary>
              <SidebarRestorePoint />
              <Astro.self entries={entry.entries} depth={depth + 1} path={path} />
            </details>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .list {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  li[hidden] {
    display: none;
  }

  .list:not(.depth-1) {
    margin: 0.125rem 0 0.375rem 1.25rem;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2rem;
    padding: 0.25rem 0.625rem;
    border-radius: var(--o-control-r);
    corner-shape: var(--corner);
    color: var(--text-muted);
    font-size: var(--text-body);
    font-weight: var(--weight-regular);
    line-height: var(--lh-callout);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .item::-webkit-details-marker {
    display: none;
  }

  .item:hover {
    background: color-mix(in oklab, var(--neutral-10) 6%, transparent);
    color: var(--text-default);
  }

  .item:focus-visible {
    outline: 2px solid var(--focus-ring-color);
    outline-offset: -2px;
  }

  .item[aria-current='page'] {
    background: var(--bg-raised);
    color: var(--text-default);
    font-weight: var(--weight-medium);
    box-shadow: var(--shadow-raised);
  }

  .text {
    flex: 1;
    min-width: 0;
  }

  .item :global(.icon) {
    flex: none;
    color: var(--text-faint);
  }

  .item :global(.caret) {
    flex: none;
    color: var(--text-faint);
    transition: transform var(--spring-press-duration) var(--spring-press);
  }

  details[open] > summary :global(.caret) {
    transform: rotate(90deg);
  }

  .badge {
    flex: none;
    padding: 0 0.3125rem;
    border-radius: calc(0.375rem * var(--corner-scale));
    corner-shape: var(--corner);
    background: color-mix(in oklab, var(--neutral-10) 7%, transparent);
    color: var(--text-muted);
    font-size: var(--text-micro);
    line-height: 1.125rem;
  }
</style>
