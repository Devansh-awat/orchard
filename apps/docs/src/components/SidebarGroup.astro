---
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';
import Icon from './Icon.astro';
import { groupIcons } from '../lib/nav';
import type { IconName } from '../lib/icons';

type SidebarEntry = NonNullable<App.Locals['starlightRoute']>['sidebar'][number];

interface Props {
  entries: SidebarEntry[];
  depth: number;
  path: string;
  icon?: IconName;
}

const { entries, depth, path, icon } = Astro.props;

function containsCurrent(entry: SidebarEntry): boolean {
  if (entry.type === 'link') return isCurrent(entry);
  return entry.entries.some(containsCurrent);
}

function isCurrent(entry: Extract<SidebarEntry, { type: 'link' }>): boolean {
  if (entry.isCurrent) return true;
  return entry.href === '/changelog/' && path.startsWith('/changelog/');
}
---

<ul class:list={['list', `depth-${depth}`]}>
  {
    entries.map((entry) => {
      const entryIcon = icon ?? (depth === 1 ? groupIcons[entry.label] : undefined);
      return (
        <li>
          {entry.type === 'link' ? (
            <a
              href={entry.href}
              aria-current={isCurrent(entry) ? 'page' : undefined}
              class:list={['item', entry.attrs.class]}
            >
              {entryIcon && <Icon name={entryIcon} class="icon" />}
              <span class="text">{entry.label}</span>
              {entry.badge && (
                <span class:list={['badge', entry.badge.class, `badge-${entry.badge.variant}`]}>
                  {entry.badge.text}
                </span>
              )}
            </a>
          ) : (
            <details open={containsCurrent(entry) || !entry.collapsed}>
              <summary class="item">
                {entryIcon && <Icon name={entryIcon} class="icon" />}
                <span class="text">{entry.label}</span>
                <Icon name="chevron-right" class="caret" />
              </summary>
              <SidebarRestorePoint />
              <Astro.self entries={entry.entries} depth={depth + 1} path={path} />
            </details>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .list {
    display: grid;
    gap: 0.0625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  li[hidden] {
    display: none;
  }

  .list:not(.depth-1) {
    margin: 0.125rem 0 0.25rem 1.1875rem;
    padding-inline-start: 0.5rem;
    border-inline-start: 1px solid var(--o-rule);
  }

  .item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2rem;
    padding: 0.3125rem 0.75rem;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-1);
    font-size: 0.875rem;
    line-height: 1.35;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .item::-webkit-details-marker {
    display: none;
  }

  .item:hover {
    background: var(--o-fill-quiet);
    color: var(--sl-color-white);
  }

  .item:focus-visible {
    outline: 2px solid var(--o-accent-text);
    outline-offset: -2px;
  }

  .item[aria-current='page'] {
    background: var(--o-fill);
    color: var(--sl-color-white);
  }

  .text {
    flex: 1;
    min-width: 0;
  }

  .item :global(.icon) {
    flex: none;
    color: var(--sl-color-gray-2);
  }

  .item :global(.caret) {
    flex: none;
    color: var(--sl-color-gray-2);
    transition: transform 0.15s ease;
  }

  details[open] > summary :global(.caret) {
    transform: rotate(90deg);
  }

  .badge {
    flex: none;
    padding: 0 0.3125rem;
    border: 1px solid var(--o-rule);
    border-radius: 0.25rem;
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: 0.625rem;
    line-height: 1.125rem;
    text-transform: uppercase;
  }
</style>
