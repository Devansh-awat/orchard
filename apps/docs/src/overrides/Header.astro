---
import Search from '@astrojs/starlight/components/Search.astro';
import Icon from '../components/Icon.astro';
import SiteTitle from './SiteTitle.astro';
import ThemeSelect from './ThemeSelect.astro';
import { REPO_URL } from '../lib/nav';
---

<div class="bar">
  <div class="left">
    <span class="brand"><SiteTitle /></span>
  </div>
  <div class="right print:hidden">
    <Search />
    <a class="o-icon-button github" href={REPO_URL} aria-label="GitHub" title="GitHub">
      <Icon mark="github" size={18} />
    </a>
    <span class="theme"><ThemeSelect /></span>
    <a class="o-btn o-btn-primary o-btn-sm install" href="/start/install/">Install</a>
  </div>
</div>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }

  .left,
  .right {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .left {
    gap: 1.25rem;
  }

  .right {
    gap: 0.5rem;
  }

    .github,
  .theme,
  .install {
    display: none;
  }

  @media (min-width: 50rem) {
    .brand {
      display: none;
    }

    .github,
    .theme,
    .install {
      display: inline-flex;
    }
  }
</style>
