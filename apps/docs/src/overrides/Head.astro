---
import Default from '@astrojs/starlight/components/Head.astro';
import { markdownPath, normalizePath } from '../lib/nav';

const { entry } = Astro.locals.starlightRoute;
const is404 = entry.id === '404' || entry.id.endsWith('/404');
const path = normalizePath(Astro.url.pathname);
---

<Default />
<link
  rel="preload"
  href="/fonts/PlusJakartaSans-VariableFont_wght.ttf"
  as="font"
  type="font/ttf"
  crossorigin
/>
{!is404 && <link rel="alternate" type="text/markdown" href={markdownPath(path)} />}
{
  path.startsWith('/changelog/') && (
    <link rel="alternate" type="application/rss+xml" title="Orchard changelog" href="/changelog/index.xml" />
  )
}
