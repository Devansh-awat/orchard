---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageActions from '../components/PageActions.astro';
import { isLanding, normalizePath } from '../lib/nav';

const { entry } = Astro.locals.starlightRoute;
const landing = isLanding(Astro.url.pathname);
const title = normalizePath(Astro.url.pathname) === '/api/' ? 'API reference' : entry.data.title;
---

{
  landing ? (
    <span data-no-title hidden />
  ) : (
    <div class="article-head">
      <Breadcrumbs title={title} />
      <h1 id="_top">{title}</h1>
      <PageActions />
    </div>
  )
}

<style>
  h1 {
    margin: 1.125rem 0 0;
    color: var(--sl-color-white);
    font-size: var(--text-display);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
    line-height: var(--lh-display);
    text-wrap: balance;
  }
</style>
