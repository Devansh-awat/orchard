<script is:inline>
  (() => {
    let stored = null;
    try {
      stored = localStorage.getItem('starlight-theme');
    } catch {}
    const theme = stored === 'light' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    document.documentElement.classList.toggle('dark', theme === 'dark');
  })();
</script>
