---
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import MobileMenuFooter from './MobileMenuFooter.astro';
import SidebarGroup from '../components/SidebarGroup.astro';
import SiteTitle from './SiteTitle.astro';
import { normalizePath } from '../lib/nav';

const { sidebar } = Astro.locals.starlightRoute;
const path = normalizePath(Astro.url.pathname);
const onApiPage = path.startsWith('/api/');
---

<div class="filter">
  <div class="brand"><SiteTitle /></div>
  <div class="field">
  <input
    id="sidebar-filter"
    type="text"
    placeholder="Filter sidebar"
    aria-label="Filter sidebar"
    aria-keyshortcuts="/"
    autocomplete="off"
    spellcheck="false"
    data-sidebar-filter
  />
  <kbd aria-hidden="true">/</kbd>
  </div>
</div>

<SidebarPersister>
  <div class="o-side-nav" data-sidebar-nav>
    {
      sidebar.map((section) =>
        section.type === 'link' ? (
          <SidebarGroup entries={[section]} depth={1} />
        ) : section.label === 'API reference' && !onApiPage ? (
          <section>
            <h2>API</h2>
            <SidebarGroup
              entries={[
                {
                  type: 'link',
                  label: 'API reference',
                  href: '/api/',
                  isCurrent: false,
                  badge: undefined,
                  attrs: {}
                }
              ]}
              depth={1}
             
              icon="code"
            />
          </section>
        ) : (
          <section>
            <h2>{section.label}</h2>
            <SidebarGroup entries={section.entries} depth={1} />
          </section>
        )
      )
    }
    <p class="empty" data-sidebar-empty hidden>No matching pages.</p>
  </div>
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-sidebar-filter]');
  const nav = document.querySelector<HTMLElement>('[data-sidebar-nav]');
  const empty = document.querySelector<HTMLElement>('[data-sidebar-empty]');

  const pane = document.getElementById('starlight__sidebar');
  const current = nav?.querySelector<HTMLElement>('[aria-current="page"]');
  if (pane && current && matchMedia('(min-width: 50rem)').matches) {
    const paneBox = pane.getBoundingClientRect();
    const box = current.getBoundingClientRect();
    if (box.top < paneBox.top + 64 || box.bottom > paneBox.bottom) {
      pane.scrollTop += box.top - paneBox.top - paneBox.height / 3;
    }
  }

  if (input && nav && empty) {
    const groups = [...nav.querySelectorAll<HTMLDetailsElement>('details')];
    const openBeforeFilter = new Map<HTMLDetailsElement, boolean>();

    const showAll = () => {
      nav.querySelectorAll<HTMLElement>('[hidden]').forEach((node) => {
        if (node !== empty) node.hidden = false;
      });
      openBeforeFilter.forEach((open, details) => {
        details.open = open;
      });
      openBeforeFilter.clear();
      empty.hidden = true;
    };

    const apply = () => {
      const query = input.value.trim().toLowerCase();
      if (!query) {
        showAll();
        return;
      }
      if (openBeforeFilter.size === 0) {
        groups.forEach((details) => openBeforeFilter.set(details, details.open));
      }

      nav.querySelectorAll<HTMLElement>('li').forEach((item) => {
        const link = item.querySelector<HTMLElement>(':scope > a');
        if (link) item.hidden = !link.textContent?.toLowerCase().includes(query);
      });

      [...groups].reverse().forEach((details) => {
        const item = details.parentElement as HTMLElement;
        const label = details.querySelector('summary')?.textContent?.toLowerCase() ?? '';
        if (label.includes(query)) {
          item.hidden = false;
          details.querySelectorAll<HTMLElement>('li').forEach((child) => {
            child.hidden = false;
          });
          details.open = false;
          return;
        }
        const match = [...details.querySelectorAll<HTMLElement>(':scope > ul > li')].some(
          (child) => !child.hidden
        );
        item.hidden = !match;
        details.open = match;
      });

      let any = false;
      nav.querySelectorAll<HTMLElement>('section').forEach((section) => {
        const visible = [...section.querySelectorAll<HTMLElement>(':scope > ul > li')].some(
          (child) => !child.hidden
        );
        section.hidden = !visible;
        any ||= visible;
      });
      empty.hidden = any;
    };

    input.addEventListener('input', apply);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        input.value = '';
        apply();
        input.blur();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
      const active = document.activeElement;
      if (
        active instanceof HTMLInputElement ||
        active instanceof HTMLTextAreaElement ||
        active instanceof HTMLSelectElement ||
        (active instanceof HTMLElement && active.isContentEditable)
      ) {
        return;
      }
      if (input.offsetParent === null) return;
      event.preventDefault();
      input.focus();
    });
  }
</script>

<style>
  .filter {
    position: sticky;
    top: 0;
    z-index: 2;
    margin: -0.75rem -0.75rem 0;
    padding: 0.75rem 0.75rem 0.5rem;
    background: var(--neutral-chrome);
  }

  .brand {
    display: none;
    margin-bottom: 0.75rem;
    padding-inline: 0.25rem;
  }

  .field {
    position: relative;
    display: block;
  }

  input {
    width: 100%;
    height: 2rem;
    padding: 0 2.25rem 0 0.75rem;
    border: 0;
    border-radius: var(--o-control-r);
    corner-shape: var(--corner);
    background: var(--o-fill);
    color: var(--text-default);
    font: inherit;
    font-size: var(--text-body);
  }

  input::placeholder {
    color: var(--text-muted);
    opacity: 1;
  }

  input:focus-visible {
    outline: 2px solid var(--focus-ring-color);
    outline-offset: 1px;
  }

  kbd {
    position: absolute;
    top: 50%;
    right: 0.375rem;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: calc(0.375rem * var(--corner-scale));
    corner-shape: var(--corner);
    background: var(--bg-raised);
    color: var(--text-muted);
    font-size: var(--text-micro);
    transform: translateY(-50%);
  }

  .o-side-nav {
    display: grid;
    gap: 1.25rem;
    padding-block: 0.5rem 1rem;
  }

  section[hidden] {
    display: none;
  }

  h2 {
    margin: 0 0 0.25rem;
    padding-inline: 0.625rem;
    color: var(--text-faint);
    font-family: var(--sl-font);
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    line-height: var(--lh-caption);
  }

  .empty {
    margin: 0;
    padding-inline: 0.625rem;
    color: var(--text-muted);
    font-size: var(--text-body);
  }

  @media (min-width: 50rem) {
    .brand {
      display: block;
    }
  }

  @media (max-width: 49.99rem) {
    kbd {
      display: none;
    }
  }
</style>
