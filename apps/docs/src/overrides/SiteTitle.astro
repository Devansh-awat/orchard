---
import HackClubOrchardLogo from '../components/HackClubOrchardLogo.astro';
---

<a href="/" class="site-home" aria-label="Hack Club Orchard Docs home">
  <HackClubOrchardLogo />
  <span class="pill" aria-hidden="true">Docs</span>
</a>

<style>
  .site-home {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
  }

  .pill {
    padding: 0 0.375rem;
    border-radius: calc(0.375rem * var(--corner-scale));
    corner-shape: var(--corner);
    background: color-mix(in oklab, var(--neutral-10) 7%, transparent);
    color: var(--text-muted);
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    line-height: 1.25rem;
  }
</style>
