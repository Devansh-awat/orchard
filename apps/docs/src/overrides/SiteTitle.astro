---
import HackClubFlag from '../components/HackClubFlag.astro';
---

<div class="site-title">
  <a href="https://hackclub.com" class="flag" aria-label="Hack Club">
    <HackClubFlag />
  </a>
  <a href="/" class="site-home" aria-label="Hack Club Orchard Docs home">
    <img src="/logo/logocolor.svg" alt="" width="124" height="30" class="logo-light" />
    <img src="/logo/logocolordm.svg" alt="" width="124" height="30" class="logo-dark" />
    <span class="pill" aria-hidden="true">Docs</span>
  </a>
</div>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .flag {
    display: flex;
    color: var(--red-solid);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .flag:hover {
    transform: rotate(-6deg) scale(1.05);
  }

  .flag :global(svg) {
    height: 1.375rem;
    width: auto;
  }

  .site-home {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
  }

  img {
    height: 1.5rem;
    width: auto;
  }

  .pill {
    padding: 0 0.375rem;
    border-radius: calc(0.375rem * var(--corner-scale));
    corner-shape: var(--corner);
    background: color-mix(in oklab, var(--neutral-10) 7%, transparent);
    color: var(--text-muted);
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    line-height: 1.25rem;
  }

  .logo-dark {
    display: none;
  }

  :global([data-theme='dark']) .logo-light {
    display: none;
  }

  :global([data-theme='dark']) .logo-dark {
    display: block;
  }
</style>
