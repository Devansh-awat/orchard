---
import Icon from '../components/Icon.astro';
import ThemeSelect from './ThemeSelect.astro';
import { REPO_URL } from '../lib/nav';
---

<div class="mobile-footer">
  <a class="o-btn o-btn-primary o-btn-sm" href="/start/install/">Install</a>
  <a class="o-icon-button" href={REPO_URL} aria-label="GitHub" title="GitHub">
    <Icon mark="github" size={18} />
  </a>
  <ThemeSelect />
</div>

<style>
  .mobile-footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 1rem;
    border-top: 1px solid var(--o-rule);
  }

  .mobile-footer .o-btn {
    margin-inline-end: auto;
  }
</style>
