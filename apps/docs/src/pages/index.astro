---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CopyPromptButton from '../components/CopyPromptButton.astro';
import Icon from '../components/Icon.astro';
import AgentPanel from '../components/home/AgentPanel.astro';
import { HERO_TEXT, homeSections, homeStarts } from '../lib/home';
---

<StarlightPage
  frontmatter={{
    title: 'Hack Club Orchard Docs',
    head: [{ tag: 'title', content: 'Hack Club Orchard Docs' }],
    description: HERO_TEXT,
    tableOfContents: false,
    lastUpdated: false,
    prev: false,
    next: false
  }}
>
  <div class="o-landing o-home not-content">
    <section class="hero">
      <h1>Hack Club Orchard Docs</h1>
      <p>{HERO_TEXT}</p>
      <div class="actions">
        <a class="o-btn o-btn-primary" href="/start/what-is-orchard/">Get started</a>
        <CopyPromptButton />
      </div>
    </section>

    <section class="starts" aria-label="Where to start">
      {
        homeStarts.map((start) => (
          <a class="start" href={start.href}>
            <span class="tile">
              <Icon name={start.icon} size={18} />
            </span>
            <h2>{start.title}</h2>
            <p>{start.text}</p>
          </a>
        ))
      }
    </section>

    <section class="sections" aria-labelledby="sections-heading">
      <h2 id="sections-heading">Browse the docs</h2>
      <div class="section-grid">
        {
          homeSections.map((section) => (
            <div class="widget">
              <h3>
                <Icon name={section.icon} size={16} />
                {section.title}
              </h3>
              <ul>
                {section.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <AgentPanel />
  </div>
</StarlightPage>

<style>
  .o-home {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    max-width: 68rem;
    margin-inline: auto;
    padding: 2rem var(--o-page-pad) 3rem;
  }

  h1 {
    margin: 0;
    color: var(--text-default);
    font-size: var(--text-display);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.03em;
    line-height: var(--lh-display);
  }

  .hero p {
    max-width: 32rem;
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-size: var(--text-headline);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .starts,
  .section-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14.5rem, 1fr));
    gap: 0.75rem;
  }

  .start,
  .widget {
    padding: 1rem;
    border-radius: var(--o-widget-r);
    corner-shape: var(--corner);
    background: var(--bg-surface);
    box-shadow: var(--shadow-raised);
  }

  .start {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-fast) ease;
  }

  .start:hover {
    background: var(--bg-hover);
  }

  .tile {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--o-control-r);
    corner-shape: var(--corner);
    background: var(--accent-subtle);
    color: var(--accent-9);
  }

  .start h2 {
    margin: 0.75rem 0 0;
    color: var(--text-default);
    font-size: var(--text-headline);
    font-weight: var(--weight-medium);
    line-height: var(--lh-headline);
  }

  .start p {
    margin: 0.25rem 0 0;
    color: var(--text-muted);
    font-size: var(--text-callout);
    line-height: var(--lh-callout);
    text-wrap: pretty;
  }

  .sections > h2 {
    margin: 0 0 0.75rem;
    color: var(--text-default);
    font-size: var(--text-title-2);
    font-weight: var(--weight-medium);
    line-height: var(--lh-title-2);
  }

  .widget h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    color: var(--text-default);
    font-size: var(--text-headline);
    font-weight: var(--weight-medium);
    line-height: var(--lh-headline);
  }

  .widget h3 :global(svg) {
    color: var(--text-faint);
  }

  ul {
    display: grid;
    gap: 0.125rem;
    margin: 0 -0.5rem;
    padding: 0;
    list-style: none;
  }

  .widget a {
    display: block;
    padding: 0.25rem 0.5rem;
    border-radius: calc(0.5rem * var(--corner-scale));
    corner-shape: var(--corner);
    color: var(--text-muted);
    font-size: var(--text-callout);
    line-height: var(--lh-callout);
    text-decoration: none;
  }

  .widget a:hover {
    background: color-mix(in oklab, var(--neutral-10) 6%, transparent);
    color: var(--text-default);
  }
</style>
