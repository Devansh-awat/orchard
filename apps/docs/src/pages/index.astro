---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CopyPromptButton from '../components/CopyPromptButton.astro';
import AgentPanel from '../components/home/AgentPanel.astro';
import HomeTabs from '../components/home/HomeTabs.astro';
import WhatsNew from '../components/home/WhatsNew.astro';
import { HERO_TEXT, TABS_HEADING } from '../lib/home';
---

<StarlightPage
  frontmatter={{
    title: 'Orchard Docs',
    description: HERO_TEXT,
    tableOfContents: false,
    lastUpdated: false,
    prev: false,
    next: false
  }}
>
  <div class="o-landing o-home not-content">
    <div class="edge" aria-hidden="true">
      <div class="o-dots edge-dots"></div>
    </div>
    <section class="hero">
      <h1>Orchard Docs</h1>
      <p>{HERO_TEXT}</p>
      <div class="actions">
        <a class="o-btn o-btn-primary" href="/start/install/">Get started</a>
        <CopyPromptButton />
      </div>
    </section>
    <section class="features" aria-labelledby="features-heading">
      <h2 id="features-heading">{TABS_HEADING}</h2>
      <HomeTabs />
    </section>
    <AgentPanel />
    <WhatsNew />
  </div>
</StarlightPage>

<style>
  .o-home {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4rem;
    max-width: 90rem;
    padding: 3rem var(--o-page-pad) 0;
  }

  .edge {
    display: none;
  }

  h1 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(2.5rem, 2rem + 2.4vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .hero p {
    max-width: 30rem;
    margin: 1rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: 1.125rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  h2 {
    margin: 0 0 1.75rem;
    color: var(--sl-color-white);
    font-size: clamp(1.5rem, 1.3rem + 0.9vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  @media (min-width: 50rem) {
    .o-home {
      gap: 5rem;
      padding-block-start: 5rem;
    }

    .edge {
      position: fixed;
      top: var(--sl-nav-height);
      right: 0;
      bottom: 0;
      display: block;
      width: var(--o-page-pad);
      border-inline-start: 1px dashed var(--o-rule);
    }

    .edge-dots {
      position: absolute;
      inset: 0;
      mask-image: linear-gradient(to left, black 30%, transparent);
    }
  }
</style>
