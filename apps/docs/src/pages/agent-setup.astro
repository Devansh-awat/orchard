---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CenteredHeader from '../components/CenteredHeader.astro';
import Command from '../components/Command.astro';
import CopyPromptButton from '../components/CopyPromptButton.astro';
import CornerMarks from '../components/CornerMarks.astro';
import Icon from '../components/Icon.astro';
import InlineText from '../components/InlineText.astro';
import { AGENT_SETUP, clients, examplePrompts, urlOptions } from '../lib/agent-setup';
import { MCP_URL, SETUP_PROMPT } from '../lib/nav';
---

<StarlightPage
  frontmatter={{
    title: AGENT_SETUP.title,
    description: AGENT_SETUP.description,
    tableOfContents: false,
    lastUpdated: false,
    prev: false,
    next: false
  }}
>
  <div class="o-landing o-wide o-page not-content">
    <CenteredHeader title={AGENT_SETUP.title} text={AGENT_SETUP.description}>
      <div class="actions">
        <CopyPromptButton prompt={SETUP_PROMPT} />
        <a class="o-btn o-btn-primary" href="#clients">
          {AGENT_SETUP.browse}
          <Icon name="arrow-down" size={14} />
        </a>
      </div>
    </CenteredHeader>

    <section id="clients" class="section">
      <h2>{AGENT_SETUP.pickHeading}</h2>
      <p class="lede">{AGENT_SETUP.pickText}</p>
      <div class="picker" data-tabs>
        <CornerMarks />
        <div class="tablist" role="tablist" aria-label="Clients">
          {
            clients.map((client, index) => (
              <button
                type="button"
                role="tab"
                id={`client-tab-${client.id}`}
                aria-controls={`client-${client.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
              >
                <span class="tile">
                  <Icon mark={client.mark} name={client.icon} size={20} />
                </span>
                <span class="names">
                  <span class="o-label">{client.vendor}</span>
                  <span class="name">{client.name}</span>
                </span>
              </button>
            ))
          }
        </div>
        {
          clients.map((client, index) => (
            <section
              class="panel"
              role="tabpanel"
              id={`client-${client.id}`}
              aria-labelledby={`client-tab-${client.id}`}
              tabindex="0"
              hidden={index !== 0}
            >
              <h3>{client.name}</h3>
              <ol>
                {client.steps.map((step) => (
                  <li>
                    <p>
                      <InlineText text={step.text} />
                    </p>
                    {step.code && <Command code={step.code} title={step.title} label="Copy" />}
                  </li>
                ))}
              </ol>
            </section>
          ))
        }
      </div>
    </section>

    <section class="section split">
      <div>
        <h2>{AGENT_SETUP.urlHeading}</h2>
        <p class="lede url-text">
          <InlineText text={AGENT_SETUP.urlText} />
        </p>
        <Command code={`${MCP_URL}/`} label="Copy URL" />
      </div>
      <div>
        <h2>{AGENT_SETUP.limitHeading}</h2>
        <p class="lede">{AGENT_SETUP.limitText}</p>
        <dl>
          {
            urlOptions.map((option) => (
              <div>
                <dt>
                  <InlineText text={option.label} />
                </dt>
                <dd>
                  <Command code={option.code} label="Copy URL" />
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="more">
          <a href="/mcp/">MCP for agents</a>
          <a href="/agents-code-mode/">Code mode for agents</a>
          <a href="/reference/mcp-tools/">MCP tools</a>
        </p>
      </div>
    </section>

    <section class="section">
      <h2>{AGENT_SETUP.promptsHeading}</h2>
      <p class="lede">{AGENT_SETUP.promptsText}</p>
      <div class="prompts">
        <CornerMarks />
        {
          examplePrompts.map((example) => (
            <article>
              <h3>{example.title}</h3>
              <p class="note">
                <InlineText text={example.text} />
              </p>
              <blockquote>{example.prompt}</blockquote>
              <button
                type="button"
                class="o-btn o-btn-outline o-btn-sm copy"
                data-copy={example.prompt}
                data-copied-text="Prompt copied"
              >
                <Icon name="copy" size={14} />
                <span data-copy-label>Copy prompt</span>
              </button>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</StarlightPage>

<noscript>
  <style>
    [data-tabs] [role='tabpanel'][hidden] {
      display: block;
    }
    [data-tabs] [role='tablist'] {
      display: none;
    }
  </style>
</noscript>

<script>
  import { bindTabs } from '../lib/client/tabs';

  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(bindTabs);
</script>

<style>
  .o-page {
    max-width: 70.75rem;
    margin-inline: auto;
    padding-inline: var(--o-page-pad);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .section {
    padding-block: 2.5rem 1rem;
    scroll-margin-top: var(--sl-nav-height);
  }

  h2 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .lede {
    margin: 0.625rem 0 1.5rem;
    color: var(--sl-color-gray-2);
    line-height: 1.6;
  }

  #clients > h2,
  #clients > .lede {
    text-align: center;
  }

  .picker {
    position: relative;
    border: 1px solid var(--o-rule);
    background: var(--o-raised);
  }

  .tablist {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: 1px;
    background: var(--o-rule);
    border-bottom: 1px solid var(--o-rule);
  }

  [role='tab'] {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border: 0;
    background: var(--o-raised);
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  [role='tab']:hover {
    background: color-mix(in srgb, var(--o-raised) 94%, var(--sl-color-white));
  }

  [role='tab'][aria-selected='true'] {
    background: var(--o-canvas);
    box-shadow: inset 0 -2px 0 var(--o-accent);
  }

  [role='tab']:focus-visible {
    outline-offset: -2px;
  }

  .tile {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.375rem;
    background: var(--o-fill);
    color: var(--sl-color-white);
  }

  .names {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .name {
    color: var(--sl-color-white);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .panel {
    padding: 1.5rem 1.25rem 1.75rem;
  }

  .panel:focus-visible {
    outline-offset: -2px;
  }

  .panel[hidden] {
    display: none;
  }

  .panel h3 {
    margin: 0 0 1rem;
    color: var(--sl-color-white);
    font-size: 1.125rem;
    font-weight: 500;
  }

  ol {
    display: grid;
    gap: 1.25rem;
    max-width: 46rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  ol li {
    position: relative;
    padding-inline-start: 2.25rem;
    counter-increment: step;
  }

  ol li::before {
    content: counter(step);
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--o-rule-strong);
    border-radius: 0.25rem;
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
  }

  ol p {
    margin: 0 0 0.625rem;
    color: var(--sl-color-gray-1);
    line-height: 1.5;
  }

  ol p:last-child {
    margin-bottom: 0;
  }

  :is(ol, .note, dt, .url-text) code {
    padding: 0.0625rem 0.3125rem;
    border: 1px solid var(--o-rule);
    border-radius: 0.25rem;
    background: var(--o-fill-quiet);
    color: var(--o-accent-text);
    font-family: var(--sl-font-mono);
    font-size: 0.8125em;
  }

  strong {
    color: var(--sl-color-white);
    font-weight: 500;
  }

  .split {
    display: grid;
    gap: 2.5rem;
  }

  dl {
    display: grid;
    gap: 0.875rem;
    margin: 0;
  }

  dt {
    margin-bottom: 0.375rem;
    color: var(--sl-color-gray-1);
    font-size: 0.875rem;
  }

  dd {
    margin: 0;
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 1.25rem 0 0;
  }

  .more a {
    color: var(--o-accent-text);
    font-size: 0.875rem;
  }

  .prompts {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    border-top: 1px solid var(--o-rule);
    border-inline-start: 1px solid var(--o-rule);
  }

  article {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.25rem 1.5rem 1.5rem;
    border-inline-end: 1px solid var(--o-rule);
    border-bottom: 1px solid var(--o-rule);
    background: var(--o-raised);
  }

  article h3 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .note {
    margin: 0.375rem 0 0.875rem;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  blockquote {
    margin: 0 0 1rem;
    padding: 0.75rem;
    border: 1px solid var(--o-rule);
    border-radius: 0.375rem;
    background: var(--o-code);
    color: var(--sl-color-gray-1);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .copy {
    align-self: flex-start;
    margin-top: auto;
    cursor: copy;
  }

  @media (min-width: 60rem) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .tablist {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .panel {
      padding: 2rem;
    }
  }
</style>
