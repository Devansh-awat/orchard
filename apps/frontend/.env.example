# Orchard frontend environment (copy to apps/frontend/.env)
# All values are optional for local dev; the dev gateway on :4000 proxies the API.

PUBLIC_API_BASE=
PUBLIC_APP_DOMAIN=
PUBLIC_BASE_DOMAIN=
PUBLIC_DEPLOYMENT_DOMAIN=
PUBLIC_INGRESS_CNAME=
PUBLIC_MCP_URL=
PUBLIC_GROVE_ENABLED=
PUBLIC_SANDBOX_ENABLED=

# OAuth login button: hackclub (default) | oidc | none (hides the button)
PUBLIC_OAUTH_PROVIDER=
PUBLIC_OAUTH_PROVIDER_LABEL=

# PostHog analytics; leave PUBLIC_POSTHOG_KEY empty to disable
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Comma-separated extra hosts /asset-proxy may fetch from (*.r2.dev is always allowed)
ASSET_PROXY_HOSTS=
