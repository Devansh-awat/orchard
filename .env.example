# Orchard server environment (copy to apps/server/.env)
#
# Minimum to boot locally: DATABASE_URL and JWT_SECRET.
# Everything else degrades gracefully or is only needed for specific features.

# ── Core (required) ──────────────────────────────────────────────────────────
# docker compose -f docker-compose.dev.yml up -d gives you this database
DATABASE_URL=postgresql://orchard:orchard@localhost:5432/orchard
# At least 32 characters, and not this example: the server refuses to boot
# otherwise. It signs every session, cookie and sign-in code.
JWT_SECRET=change-me-to-a-long-random-string

# ── Core (recommended) ───────────────────────────────────────────────────────
PORT=3001
# The origin the browser actually loads. In dev that is the gateway on :4000,
# not Vite on :3000: the API's CORS allowlist is built from this, so pointing it
# at Vite makes every request from the gateway fail as a CORS error.
FRONTEND_URL=http://localhost:4000
# Extra first-party origins allowed to make credentialed API calls, comma
# separated. e.g. https://docs.orchard.my,https://status.orchard.my
# Together with FRONTEND_URL these are also the only origins a cookie session
# may change state from; a POST from anywhere else gets a 403.
PLATFORM_ORIGINS=
# Encrypts stored secret env vars; required to save secrets. Falls back to SSO_ENCRYPTION_KEY.
SECRETS_ENCRYPTION_KEY=
# Cross-replica SSE event bus + cache. Optional: single-instance mode without it.
REDIS_URL=redis://localhost:6379

# ── Signups ──────────────────────────────────────────────────────────────────
# open | invite_only | closed
SIGNUP_MODE=open

# ── Node scheduling ──────────────────────────────────────────────────────────
# Node pools (taints/labels/affinity) are always superadmin-managed. Whether
# normal users can pick a superadmin-whitelisted pool for their own workloads is
# a toggle in the admin panel (Admin -> Nodes). This env var OVERRIDES that
# toggle when set: 'true' forces it on, 'false' forces it off and locks the
# switch. Leave unset to let superadmins control it from the UI (default off).
USERSPACE_NODE_SCHEDULING=

# ── Kubernetes (optional for UI/API dev; required to deploy anything) ────────
# Defaults to ~/.kube/config. Accepts either a path or the kubeconfig itself
# base64 encoded. The server boots fine without a cluster.
KUBECONFIG_PATH=
# Cilium-backed edge features: per-tenant CiliumNetworkPolicy, and enforcing
# basic auth with an Envoy filter bound to the Service instead of with the
# protection proxy. Leave unset and the server probes the cluster for the
# cilium.io group plus create permission on ciliumenvoyconfigs; 'true' or
# 'false' skips the probe. Basic auth works either way.
CILIUM_ENABLED=
# Offer "sign in with Orchard" as an ingress protection mode. It sends visitors
# of a tenant host to this control plane's login and requires project
# membership, so it only suits instances whose visitors have Orchard accounts.
# Basic auth and shared-password protection are always available. Gates picking
# the mode, not enforcing it: existing walls stand regardless.
PROTECTION_ORCHARD_LOGIN=
K8S_STORAGE_CLASS=
# Most instances a single managed-database cluster may run (1 primary + standbys).
# Every instance is a pod with its own volume and bills against quota. Defaults to 5.
MAX_DATABASE_REPLICAS=
K8S_INGRESS_CLASS=
CERT_CLUSTER_ISSUER=
RESERVED_NAMESPACES_EXTRA=
# Fraction of a workload's CPU limit it actually reserves on its node, and the
# millicore floor that fraction can't go below. Defaults 0.1 / 50m. Set the
# ratio to 1 for the old requests == limits behaviour. Memory is unaffected.
CPU_REQUEST_RATIO=
CPU_REQUEST_MIN_MILLI=

# ── Domains ──────────────────────────────────────────────────────────────────
# Wildcard parent for generated app URLs (main-forge-abc123.<APP_DOMAIN>).
# Unset means Orchard generates no URLs at all and every deployment needs a
# custom domain; it never falls back to a built-in default.
APP_DOMAIN=
# CNAME target users point their own domains at. Unset disables DNS validation
# for custom domains.
INGRESS_CNAME=
# The ports this instance is reached on from outside, which are not always the
# ports Traefik listens on inside the cluster: a single-box install can be told
# to serve somewhere other than 80 and 443 (install.sh --http-port/--https-port,
# lan mode only). They appear in the URL the API returns for every ingress, so a
# client never has to guess. Leave unset unless you moved them.
PUBLIC_HTTP_PORT=
# The TLS half of the same. Both default to the standard ports.
PUBLIC_HTTPS_PORT=
# The three below are independent facts, off unless set, and NOT derived from
# APP_DOMAIN or from each other: each needs its own DNS and wildcard cert, and
# in practice they diverge (the platform UI, deployed apps and org vanity hosts
# can all live on different domains).
# Parent for org vanity subdomains (acme.<BASE_DOMAIN>).
BASE_DOMAIN=
# Parent for publicly exposed database hostnames. Keep in sync with the chart's
# certificates.wildcards.db.domain.
PUBLIC_DB_DOMAIN=
# Parent for publicly exposed deployment ports.
PUBLIC_DEPLOYMENT_DOMAIN=
# Fallback external IP that publicly exposed ports and databases are published
# on, for organizations that have not set one of their own. An organization
# with its own address still wins. Set here it also locks the matching field in
# the admin panel (Admin -> Configuration -> Public exposure). Unset means every
# organization must configure its own before it can expose anything.
PUBLIC_EXPOSURE_IP=
# Comma-separated domain=tlsSecretName pairs for wildcard certs you manage.
# Overrides the single entry otherwise derived from APP_DOMAIN.
PLATFORM_WILDCARD_DOMAINS=
WILDCARD_TLS_SOURCE_NAMESPACE=

# ── Auth: OAuth/OIDC login (optional; OTP/passkey work without it) ───────────
# hackclub | oidc | none. Defaults to hackclub when HACKCLUB_CLIENT_ID is set,
# none otherwise.
AUTH_PROVIDER=

# hackclub preset
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
HACKCLUB_REDIRECT_URI=http://localhost:3001/apiv1/auth/callback

# generic OIDC (any IdP: Keycloak, Authentik, Dex, Google, ...)
AUTH_OAUTH_CLIENT_ID=
AUTH_OAUTH_CLIENT_SECRET=
AUTH_OAUTH_REDIRECT_URI=
# discovery via issuer, or set the three explicit URLs instead
AUTH_OAUTH_ISSUER=
AUTH_OAUTH_AUTHORIZE_URL=
AUTH_OAUTH_TOKEN_URL=
AUTH_OAUTH_USERINFO_URL=
AUTH_OAUTH_SCOPES=
# claim mapping; defaults sub / email / name
AUTH_OAUTH_CLAIM_ID=
AUTH_OAUTH_CLAIM_EMAIL=
AUTH_OAUTH_CLAIM_NAME=

# ── Auth: WebAuthn/passkeys ──────────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Orchard
WEBAUTHN_ORIGIN=http://localhost:4000

# ── GitHub App (deploy-from-GitHub, webhooks) ────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ── Storage: Cloudflare R2 / S3 (avatars, backups) ───────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_BACKUP_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=

# Community template registry. The server pulls the catalogue from here on boot
# and every six hours and lists those templates alongside the built-in ones.
# Unset means the public registry below; set it empty on air-gapped instances.
TEMPLATE_REGISTRY_URL=https://assets.orchard.my/registry

# Import a profile picture from Gravatar/Libravatar when a user has one set up
# for their email. The server does the lookup and copies the image into R2, so
# users' browsers never contact the avatar service and no email hash leaks to
# it from a viewer's IP. Set to false to never look anything up; requires R2.
EMAIL_AVATAR_LOOKUP=
# Comma-separated, tried in order. Defaults to "libravatar,gravatar".
EMAIL_AVATAR_PROVIDERS=

# ── Image builds ─────────────────────────────────────────────────────────────
# local (docker daemon) | kubernetes (in-cluster buildkit jobs)
BUILD_MODE=local
DOCKER_REGISTRY_PUSH=
DOCKER_REGISTRY_PULL=
REGISTRY_PROJECT=orchard
REGISTRY_PULL_SECRET_NAME=
REGISTRY_HTTP_HOSTS=
HARBOR_USERNAME=
HARBOR_PASSWORD=
# Project registry credentials are verified against the registry before they are
# stored; registries on private or cluster-internal addresses are refused unless
# this is true.
REGISTRY_CREDENTIALS_ALLOW_INTERNAL=

# ── Pod shell sessions ──────────────────────────────────────────────────────
# How long a shell survives a dropped browser before it is reaped.
EXEC_DETACH_GRACE_MS=
# Scrollback lines kept per shell for the reattach snapshot. Each session holds a
# headless terminal; at the 200-session cap a busy 200x50 screen with 500 lines of
# scrollback is roughly 1-3 MB, so lower this on small instances.
EXEC_SNAPSHOT_SCROLLBACK=
BUILDER_NAMESPACE=orchard-builders
MAX_CONCURRENT_BUILDS=
BUILD_NO_PROXY_EXTRA=
# Optional Depot remote builders
DEPOT_TOKEN=
DEPOT_PROJECT_ID=
# Optional buildkit cache (S3-compatible or local PVC)
BUILDKIT_S3_CACHE_ENABLED=
BUILDKIT_S3_BUCKET=
BUILDKIT_S3_ENDPOINT=
BUILDKIT_S3_ACCESS_KEY_ID=
BUILDKIT_S3_SECRET_ACCESS_KEY=
BUILDKIT_LOCAL_CACHE_ENABLED=
BUILDKIT_LOCAL_CACHE_PVC=

# ── Email (SMTP; email features skip silently without it) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM=
SMTP_FROM_NAME=Orchard
EMAIL_ASSET_BASE_URL=

# ── Enterprise SSO / SCIM (optional) ─────────────────────────────────────────
SSO_ENCRYPTION_KEY=
SSO_ALLOWED_EMAIL_DOMAINS=
SSO_DEFAULT_ROLE=
SSO_REQUIRE_EMAIL_VERIFIED=
SCIM_BASE_URL=

# ── Observability (all optional, off when unset) ─────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=
# Anonymous usage reports to the Orchard team. Separate from POSTHOG_API_KEY,
# which is your own analytics. Off until a superadmin opts in, either during
# setup or from the prompt they get afterwards (Admin -> Configuration to
# change it later). 'false' turns it off and locks the switch, 'true' turns it
# on without asking. Leave unset to let a superadmin decide.
ORCHARD_TELEMETRY=
DD_TRACE_ENABLED=false
DD_AGENT_HOST=
VICTORIAMETRICS_URL=

# ── Misc (optional) ──────────────────────────────────────────────────────────
COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
TRUST_PROXY=
AI_CHAT_API_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
BACKUP_PROXY_ENABLED=
BACKUP_PROXY_ENDPOINT=
# ResourceQuota floor for tenant namespaces whose org or project has no cap.
TENANT_QUOTA_FLOOR_PODS=
TENANT_QUOTA_FLOOR_SERVICES=
TENANT_QUOTA_FLOOR_PVCS=
TENANT_QUOTA_FLOOR_STORAGE_BYTES=
# Set by the chart: the ClusterRole the server binds into each tenant namespace
# for secrets and configmaps. Unset, the server mints a per-namespace Role.
TENANT_SECRETS_CLUSTER_ROLE=

# ── Cloudflare Tunnel (optional) ─────────────────────────────────────────────
# A token-managed tunnel keeps its routing table in Cloudflare, not in the
# cluster, so the instance cannot normally see which hostnames reach it. With an
# API token it can, and Instance admin -> Networking can add a missing route and
# its DNS record. The token needs Account / Cloudflare Tunnel / Edit, plus
# Zone / DNS / Edit to create records. Without the zone ID the tunnel route is
# added but the DNS record is left to you.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_ZONE_ID=

# ── MCP ──────────────────────────────────────────────────────────────────────
# The public origin of the MCP server, used as the OAuth issuer and resource
# identifier. The chart derives it from mcp.ingress.host.
MCP_BASE_URL=
# Whether this instance accepts MCP connections at all. Defaults on, and is a
# toggle in the admin panel (Admin -> Configuration). This env var OVERRIDES
# that toggle when set: 'false' refuses every MCP request and locks the switch.
# The chart sets it to 'false' when mcp.enabled is off, because nothing is
# serving MCP then.
MCP_ENABLED=
# Pins the "require single sign-on for everyone" switch in the admin panel.
# 'true' refuses email codes, passkeys and the superadmin password for every
# account that is not a superadmin; only the configured identity providers
# sign people in. Leave blank to let the switch decide.
SSO_ENFORCED=
# Shared with the MCP process. It authenticates to this API as a service and
# passes the consenting user's identity in headers, so a mismatch surfaces as
# every tool call failing rather than as anything failing to start.
MCP_SERVICE_TOKEN=

# ── Greenhouse (AI dev machines) ─────────────────────────────────────────────

# Pins the Greenhouse switch in the admin panel (Admin -> Configuration). 'true'
# forces it on and locks the switch, 'false' forces it off. Unset lets admins
# decide; the switch starts off in production and on in development.
SANDBOX_ENABLED=
# Namespace the Kubernetes runner creates machines in.
SANDBOX_NAMESPACE=orchard-sandboxes
# Image new Kubernetes machines start from. A bootstrap script installs sshd,
# git, tmux, Node.js, Claude Code, Codex and opencode on first boot.
SANDBOX_IMAGE=debian:bookworm
# RuntimeClass for Kubernetes machines, usually kata. Empty runs them on the
# default runtime with a filesystem-mode home volume and no privileges.
SANDBOX_RUNTIME_CLASS=
# Home volume mode: block, filesystem, or auto (block when a RuntimeClass is set).
SANDBOX_HOME_MODE=
# StorageClass for home volumes. Empty uses the cluster default.
SANDBOX_STORAGE_CLASS=
# Size and limits for new Kubernetes machines. Defaults 10Gi, 2 CPUs, 4Gi.
SANDBOX_DISK_SIZE=
SANDBOX_CPU_LIMIT=
SANDBOX_MEMORY_LIMIT=
# 'portforward' reaches machines through the API server instead of pod IPs, for
# a server running outside the cluster.
SANDBOX_TUNNEL_MODE=
# Default number of machines each person may own. Admins override it per user;
# superadmins are uncapped. Defaults to 1.
SANDBOX_MAX_PER_USER=
# Stop running machines with no terminal or SSH activity and no busy agent for
# this many minutes. Defaults to 60; 0 never stops them.
SANDBOX_IDLE_TIMEOUT_MINUTES=
# Stop machines this many hours after their last start, active or not. Defaults
# to 168; 0 never stops them.
SANDBOX_MAX_LIFETIME_HOURS=
# The MCP endpoint configured into each machine's agent, authenticated as the
# machine's host. The chart derives it from mcp.ingress.host. Vercel machines
# only use an https URL.
SANDBOX_MCP_URL=
# Runners. Each of the following overrides and locks the matching field under
# Admin -> Configuration -> Sandbox runners. Kubernetes defaults on, Vercel off.
SANDBOX_RUNNER_KUBERNETES_ENABLED=
SANDBOX_RUNNER_VERCEL_ENABLED=
# kubernetes or vercel. Unset picks the first available runner.
SANDBOX_DEFAULT_RUNNER=
# Vercel access token, team id and project id that Vercel machines are created
# under. Vercel machines also require SECRETS_ENCRYPTION_KEY.
SANDBOX_VERCEL_TOKEN=
SANDBOX_VERCEL_TEAM_ID=
SANDBOX_VERCEL_PROJECT_ID=
# Image, vCPUs (1 to 8) and provider timeout in minutes (1 to 1440) for Vercel
# machines. Defaults vercel/sandbox/universal, 2 and 60.
SANDBOX_VERCEL_IMAGE=
SANDBOX_VERCEL_VCPUS=
SANDBOX_VERCEL_TIMEOUT_MINUTES=
# https URL of the linux/amd64 orchard CLI tarball Vercel machines run as their
# SSH bridge. Unset uses the release that matches this server.
SANDBOX_BRIDGE_BINARY_URL=
# Bare domain for Kubernetes previews (<port>-<machine>.<domain>). Needs wildcard
# DNS and TLS routed to the server, and must not be or share the Orchard cookie
# domain or hostnames. Unset turns Kubernetes previews off.
SANDBOX_PREVIEW_DOMAIN=
# Slack app for /greenhouse and mentions (Admin -> Configuration -> Slack app).
# The bot token starts with xoxb-. The app id, when set, ignores other apps.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_ID=
# Signing secret of the Linear webhook that delivers /greenhouse comments.
LINEAR_WEBHOOK_SECRET=
