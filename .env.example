# Orchard server environment (copy to apps/server/.env)
#
# Minimum to boot locally: DATABASE_URL and JWT_SECRET.
# Everything else degrades gracefully or is only needed for specific features.

# ── Core (required) ──────────────────────────────────────────────────────────
# docker compose -f docker-compose.dev.yml up -d gives you this database
DATABASE_URL=postgresql://orchard:orchard@localhost:5432/orchard
JWT_SECRET=change-me-to-a-long-random-string

# ── Core (recommended) ───────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000
# Encrypts stored secret env vars; required to save secrets. Falls back to SSO_ENCRYPTION_KEY.
SECRETS_ENCRYPTION_KEY=
# Cross-replica SSE event bus + cache. Optional: single-instance mode without it.
REDIS_URL=redis://localhost:6379

# ── Signups ──────────────────────────────────────────────────────────────────
# open | invite_only | closed
SIGNUP_MODE=open

# ── Node scheduling ──────────────────────────────────────────────────────────
# Node pools (taints/labels/affinity) are always superadmin-managed. Whether
# normal users can pick a superadmin-whitelisted pool for their own workloads is
# a toggle in the admin panel (Admin -> Nodes). This env var OVERRIDES that
# toggle when set: 'true' forces it on, 'false' forces it off and locks the
# switch. Leave unset to let superadmins control it from the UI (default off).
USERSPACE_NODE_SCHEDULING=

# ── Kubernetes (optional for UI/API dev; required to deploy anything) ────────
# Defaults to ~/.kube/config. The server boots fine without a cluster.
KUBECONFIG_PATH=
K8S_STORAGE_CLASS=
# Most instances a single managed-database cluster may run (1 primary + standbys).
# Every instance is a pod with its own volume and bills against quota. Defaults to 5.
MAX_DATABASE_REPLICAS=
K8S_INGRESS_CLASS=
CERT_CLUSTER_ISSUER=
RESERVED_NAMESPACES_EXTRA=
# Fraction of a workload's CPU limit it actually reserves on its node, and the
# millicore floor that fraction can't go below. Defaults 0.1 / 50m. Set the
# ratio to 1 for the old requests == limits behaviour. Memory is unaffected.
CPU_REQUEST_RATIO=
CPU_REQUEST_MIN_MILLI=

# ── Domains ──────────────────────────────────────────────────────────────────
APP_DOMAIN=
INGRESS_CNAME=
BASE_DOMAIN=
PUBLIC_DB_DOMAIN=
PUBLIC_DEPLOYMENT_DOMAIN=
# Comma-separated domain=tlsSecretName pairs for wildcard certs you manage
PLATFORM_WILDCARD_DOMAINS=

# ── Auth: OAuth/OIDC login (optional; OTP/passkey work without it) ───────────
# hackclub | oidc | none. Defaults to hackclub when HACKCLUB_CLIENT_ID is set,
# none otherwise.
AUTH_PROVIDER=

# hackclub preset
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
HACKCLUB_REDIRECT_URI=http://localhost:3001/apiv1/auth/callback

# generic OIDC (any IdP: Keycloak, Authentik, Dex, Google, ...)
AUTH_OAUTH_CLIENT_ID=
AUTH_OAUTH_CLIENT_SECRET=
AUTH_OAUTH_REDIRECT_URI=
# discovery via issuer, or set the three explicit URLs instead
AUTH_OAUTH_ISSUER=
AUTH_OAUTH_AUTHORIZE_URL=
AUTH_OAUTH_TOKEN_URL=
AUTH_OAUTH_USERINFO_URL=
AUTH_OAUTH_SCOPES=
# claim mapping; defaults sub / email / name
AUTH_OAUTH_CLAIM_ID=
AUTH_OAUTH_CLAIM_EMAIL=
AUTH_OAUTH_CLAIM_NAME=

# ── Auth: WebAuthn/passkeys ──────────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Orchard
WEBAUTHN_ORIGIN=http://localhost:4000

# ── GitHub App (deploy-from-GitHub, webhooks) ────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ── Storage: Cloudflare R2 / S3 (avatars, backups) ───────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ENDPOINT=

# ── Image builds ─────────────────────────────────────────────────────────────
# local (docker daemon) | kubernetes (in-cluster buildkit jobs)
BUILD_MODE=local
DOCKER_REGISTRY_PUSH=
DOCKER_REGISTRY_PULL=
REGISTRY_PROJECT=orchard
REGISTRY_PULL_SECRET_NAME=
REGISTRY_HTTP_HOSTS=
HARBOR_USERNAME=
HARBOR_PASSWORD=
BUILDER_NAMESPACE=orchard-builders
MAX_CONCURRENT_BUILDS=
BUILD_NO_PROXY_EXTRA=
# Optional Depot remote builders
DEPOT_TOKEN=
DEPOT_PROJECT_ID=
# Optional buildkit cache (S3-compatible or local PVC)
BUILDKIT_S3_CACHE_ENABLED=
BUILDKIT_S3_BUCKET=
BUILDKIT_S3_ENDPOINT=
BUILDKIT_S3_ACCESS_KEY_ID=
BUILDKIT_S3_SECRET_ACCESS_KEY=
BUILDKIT_LOCAL_CACHE_ENABLED=
BUILDKIT_LOCAL_CACHE_PVC=

# ── Email (SMTP; email features skip silently without it) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Orchard
EMAIL_ASSET_BASE_URL=

# ── Enterprise SSO / SCIM (optional) ─────────────────────────────────────────
SSO_ENCRYPTION_KEY=
SSO_ALLOWED_EMAIL_DOMAINS=
SSO_DEFAULT_ROLE=
SSO_REQUIRE_EMAIL_VERIFIED=
SCIM_BASE_URL=

# ── Observability (all optional, off when unset) ─────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=
DD_TRACE_ENABLED=false
DD_AGENT_HOST=
VICTORIAMETRICS_URL=

# ── Misc (optional) ──────────────────────────────────────────────────────────
COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
TRUST_PROXY=
AI_CHAT_API_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
BACKUP_PROXY_ENABLED=
BACKUP_PROXY_ENDPOINT=
MCP_BASE_URL=
