<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="15px" color="#5d3a3f" line-height="160%" padding="0" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  </mj-head>
  <mj-body background-color="#f8f4f5" width="520px">
    <mj-section padding="40px 0 24px 0">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="700" color="#c93a4f" letter-spacing="-0.5px">
          Orchard
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="12px" padding="40px 36px 36px 36px">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="600" color="#2c1a1d" letter-spacing="-0.5px" padding-bottom="8px">
          You've been invited
        </mj-text>

        <mj-text align="center" font-size="15px" color="#857073" padding-bottom="28px">
          {{inviterName}} invited you to join <strong style="color: #2c1a1d;">{{organizationName}}</strong> on Orchard.
        </mj-text>

        <mj-button background-color="#b33346" border-radius="8px" font-size="15px" font-weight="600" color="#ffffff" href="{{inviteUrl}}" padding="0 0 28px 0" inner-padding="12px 28px" font-family="'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">
          Accept Invitation
        </mj-button>

        <mj-divider border-color="#f3dfe2" border-width="1px" padding="0 0 20px 0" />

        <mj-table font-size="14px" color="#5d3a3f" cellpadding="6" css-class="details">
          <tr>
            <td style="color: #857073; padding: 6px 0;">Organization</td>
            <td style="text-align: right; font-weight: 600; padding: 6px 0;">{{organizationName}}</td>
          </tr>
          <tr>
            <td style="color: #857073; padding: 6px 0;">Your Role</td>
            <td style="text-align: right; font-weight: 600; padding: 6px 0;">{{role}}</td>
          </tr>
          <tr>
            <td style="color: #857073; padding: 6px 0;">Invited By</td>
            <td style="text-align: right; font-weight: 600; padding: 6px 0;">{{inviterName}}</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 0 40px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#857073">
          Sent to {{recipientEmail}}. This invitation expires in 7 days.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
