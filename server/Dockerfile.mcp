# syntax=docker/dockerfile:1
# Build from the project root: docker build -f server/Dockerfile.mcp -t orchard-mcp .
# Requires BuildKit. On Docker 23+ this is on by default; otherwise set DOCKER_BUILDKIT=1.

FROM node:22-bookworm-slim AS base

# Keep apt downloads cached so BuildKit cache mounts work across builds.
RUN rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates

RUN corepack enable && corepack prepare pnpm@10 --activate

FROM base AS deps
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY server/package.json ./server/

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/server/node_modules ./server/node_modules
COPY server/package.json server/tsconfig.json server/.swcrc ./server/
COPY server/src ./server/src
COPY server/prisma ./server/prisma

WORKDIR /app/server
RUN pnpm prisma:generate

EXPOSE 3100

CMD ["pnpm", "mcp:remote"]
