generator client {
  provider     = "prisma-client"
  output       = "../server/src/generated/prisma"
  engineType   = "client"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["ext_greenhouse", "public"]
}

model UserLimit {
  userId       String   @id @map("user_id") @db.Uuid
  maxSandboxes Int?     @map("max_sandboxes")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_limits")
  @@schema("ext_greenhouse")
}

model User {
  id             String  @id @db.Uuid
  email          String  @unique @db.VarChar(255)
  username       String  @unique @db.VarChar(100)
  firstName      String? @map("first_name") @db.VarChar(100)
  lastName       String? @map("last_name") @db.VarChar(100)
  imageUrl       String? @map("image_url") @db.VarChar(500)
  githubId       String? @unique @map("github_id") @db.VarChar(255)
  githubUsername String? @map("github_username") @db.VarChar(255)

  limit                UserLimit?
  sandboxes            Sandbox[]
  sandboxSessions      SandboxConversation[]   @relation("SandboxSessionCreator")
  sshIdentities        SshIdentity[]
  sandboxCredential    SandboxCredential?
  sandboxMemberships   SandboxMember[]         @relation("SandboxMemberUser")
  sandboxInvites       SandboxMember[]         @relation("SandboxMemberInviter")
  sandboxPromptAuthors SandboxPromptAuthor[]
  sandboxMessages      SandboxSessionMessage[]
  sandboxShareLinks    SandboxShareLink[]      @relation("SandboxShareLinkCreator")
  sandboxProjectLinks  SandboxProjectLink[]
  integrations         UserIntegration[]
  contextItems         UserContextItem[]
  organizationMembers  OrganizationMember[]

  @@map("users")
  @@schema("public")
}

model Organization {
  id String @id @db.Uuid

  sandboxes Sandbox[]
  members   OrganizationMember[]
  projects  Project[]

  @@map("organizations")
  @@schema("public")
}

enum OrganizationRole {
  owner
  admin
  member
  guest

  @@map("organization_role")
  @@schema("public")
}

model OrganizationMember {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  addedAt        DateTime         @map("added_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_members")
  @@schema("public")
}

model Project {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String @db.VarChar(255)
  slug           String @db.VarChar(100)

  organization        Organization         @relation(fields: [organizationId], references: [id])
  environments        Environment[]
  deployments         Deployment[]
  databases           Database[]
  sandboxProjectLinks SandboxProjectLink[]

  @@unique([organizationId, slug])
  @@map("projects")
  @@schema("public")
}

model Environment {
  id           String  @id @db.Uuid
  projectId    String  @map("project_id") @db.Uuid
  name         String  @db.VarChar(100)
  slug         String  @db.VarChar(100)
  namespace    String  @unique @db.VarChar(100)
  isDefault    Boolean @map("is_default")
  isProduction Boolean @map("is_production")

  project             Project                @relation(fields: [projectId], references: [id])
  deployments         Deployment[]
  databases           Database[]
  sharedVars          EnvironmentSharedVar[]
  sandboxProjectLinks SandboxProjectLink[]

  @@unique([projectId, slug])
  @@map("environments")
  @@schema("public")
}

model EnvironmentSharedVar {
  id            String  @id @db.Uuid
  environmentId String  @map("environment_id") @db.Uuid
  key           String  @db.VarChar(255)
  value         String  @db.Text
  secret        Boolean

  environment Environment @relation(fields: [environmentId], references: [id])

  @@unique([environmentId, key])
  @@map("environment_shared_vars")
  @@schema("public")
}

enum BuildType {
  dockerfile
  railpack

  @@map("build_type")
  @@schema("public")
}

model Deployment {
  id                 String    @id @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  environmentId      String?   @map("environment_id") @db.Uuid
  name               String    @db.VarChar(255)
  status             String    @db.VarChar(50)
  buildStatus        String    @map("build_status") @db.VarChar(50)
  applyStatus        String    @map("apply_status") @db.VarChar(20)
  stopped            Boolean
  buildType          BuildType @map("build_type")
  githubRepo         String?   @map("github_repo") @db.VarChar(500)
  githubBranch       String?   @map("github_branch") @db.VarChar(255)
  dockerfilePath     String?   @map("dockerfile_path") @db.VarChar(500)
  dockerfileTarget   String?   @map("dockerfile_target") @db.VarChar(255)
  buildFromRoot      Boolean   @map("build_from_root")
  rootDirectory      String?   @map("root_directory") @db.VarChar(500)
  framework          String?   @map("framework") @db.VarChar(50)
  installCommand     String?   @map("install_command") @db.VarChar(2000)
  buildCommand       String?   @map("build_command") @db.VarChar(2000)
  startCommand       String?   @map("start_command") @db.VarChar(2000)
  outputDirectory    String?   @map("output_directory") @db.VarChar(500)
  cpuRequestMilli    Int?      @map("cpu_request_milli")
  memoryRequestBytes BigInt?   @map("memory_request_bytes")
  gitConnectionId    String?   @map("git_connection_id") @db.Uuid
  externalRepoId     String?   @map("external_repo_id") @db.VarChar(120)
  templateInstanceId String?   @map("template_instance_id") @db.Uuid
  composeStackId     String?   @map("compose_stack_id") @db.Uuid
  createdAt          DateTime  @map("created_at") @db.Timestamp(6)

  project     Project            @relation(fields: [projectId], references: [id])
  environment Environment?       @relation(fields: [environmentId], references: [id])
  envVars     DeploymentEnvVar[]
  volumes     DeploymentVolume[]
  services    Service[]
  ingresses   Ingress[]

  @@unique([environmentId, name])
  @@map("deployments")
  @@schema("public")
}

model DeploymentEnvVar {
  id           String  @id @db.Uuid
  deploymentId String  @map("deployment_id") @db.Uuid
  key          String  @db.VarChar(255)
  value        String  @db.Text
  secret       Boolean

  deployment Deployment @relation(fields: [deploymentId], references: [id])

  @@unique([deploymentId, key])
  @@map("deployment_env_vars")
  @@schema("public")
}

enum VolumeType {
  pvc
  hostPath
  emptyDir

  @@map("volume_type")
  @@schema("public")
}

model DeploymentVolume {
  id           String     @id @db.Uuid
  deploymentId String     @map("deployment_id") @db.Uuid
  name         String     @db.VarChar(255)
  type         VolumeType
  mountPath    String     @map("mount_path") @db.VarChar(500)
  pvcName      String?    @map("pvc_name") @db.VarChar(255)
  storageSize  String?    @map("storage_size") @db.VarChar(20)
  readOnly     Boolean    @map("read_only")

  deployment Deployment @relation(fields: [deploymentId], references: [id])

  @@unique([deploymentId, name])
  @@map("deployment_volumes")
  @@schema("public")
}

model Service {
  id           String   @id @db.Uuid
  deploymentId String   @map("deployment_id") @db.Uuid
  createdAt    DateTime @map("created_at") @db.Timestamp(6)

  deployment Deployment    @relation(fields: [deploymentId], references: [id])
  ports      ServicePort[]

  @@map("services")
  @@schema("public")
}

model ServicePort {
  id         String  @id @db.Uuid
  serviceId  String  @map("service_id") @db.Uuid
  name       String? @db.VarChar(63)
  port       Int
  targetPort Int     @map("target_port")
  protocol   String  @db.VarChar(10)

  service Service @relation(fields: [serviceId], references: [id])

  @@map("service_ports")
  @@schema("public")
}

model Ingress {
  id            String   @id @db.Uuid
  deploymentId  String?  @map("deployment_id") @db.Uuid
  host          String   @db.VarChar(255)
  path          String   @db.VarChar(255)
  tlsSecretName String?  @map("tls_secret_name") @db.VarChar(255)
  entrypoints   String[]
  createdAt     DateTime @map("created_at") @db.Timestamp(6)

  deployment Deployment? @relation(fields: [deploymentId], references: [id])

  @@map("ingresses")
  @@schema("public")
}

model Database {
  id            String  @id @db.Uuid
  projectId     String  @map("project_id") @db.Uuid
  environmentId String? @map("environment_id") @db.Uuid
  name          String  @db.VarChar(255)
  dbName        String  @unique @map("db_name") @db.VarChar(63)
  dbUser        String  @map("db_user") @db.VarChar(63)
  dbPassword    String  @map("db_password") @db.Text
  mode          String  @db.VarChar(20)
  namespace     String? @db.VarChar(100)
  clusterName   String? @map("cluster_name") @db.VarChar(100)
  publicEnabled Boolean @map("public_enabled")
  publicIp      String? @map("public_ip") @db.VarChar(45)
  publicPort    Int?    @map("public_port")
  createdAt     DateTime @map("created_at") @db.Timestamp(6)

  project     Project      @relation(fields: [projectId], references: [id])
  environment Environment? @relation(fields: [environmentId], references: [id])

  @@unique([environmentId, name])
  @@map("databases")
  @@schema("public")
}

model K8sObject {
  uid        String @id @db.VarChar(64)
  apiVersion String @map("api_version") @db.VarChar(100)
  kind       String @db.VarChar(60)
  namespace  String @db.VarChar(100)
  name       String @db.VarChar(255)
  shard      String @db.VarChar(40)
  manifest   Json   @db.JsonB

  @@unique([kind, namespace, name, apiVersion])
  @@map("k8s_objects")
  @@schema("public")
}
model K8sApplyItem {
  id        String   @id @db.Uuid
  status    String   @db.VarChar(20)
  lastError String?  @map("last_error") @db.Text
  sandboxId String?  @map("sandbox_id") @db.Uuid
  updatedAt DateTime @map("updated_at") @db.Timestamp(6)

  @@map("k8s_apply_queue")
  @@schema("public")
}

model K8sMirrorHeartbeat {
  shard      String    @id @db.VarChar(40)
  holder     String?   @db.VarChar(120)
  lastListAt DateTime? @map("last_list_at") @db.Timestamp(6)
  healthy    Boolean
  updatedAt  DateTime  @map("updated_at") @db.Timestamp(6)

  @@map("k8s_mirror_heartbeats")
  @@schema("public")
}

enum SandboxStatus {
  creating
  starting
  running
  stopping
  stopped
  deleting
  error

  @@schema("public")
}

enum SandboxRunnerKind {
  kubernetes
  vercel

  @@schema("public")
}

enum SandboxDesiredState {
  running
  stopped
  deleted

  @@schema("public")
}

model Sandbox {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  name          String        @db.VarChar(63)
  status        SandboxStatus @default(creating)
  statusMessage String?       @map("status_message") @db.Text
  podName       String        @unique @map("pod_name") @db.VarChar(253)
  namespace     String?       @db.VarChar(253)
  runner        SandboxRunnerKind   @default(kubernetes)
  desiredState  SandboxDesiredState @default(running) @map("desired_state")
  externalId    String?       @map("external_id") @db.VarChar(255)
  runnerState   Json?         @map("runner_state") @db.JsonB
  secretEpoch   Int           @default(0) @map("secret_epoch")
  image         String        @db.VarChar(500)
  repoUrl       String?       @map("repo_url") @db.VarChar(500)
  sshIdentityId String?       @map("ssh_identity_id") @db.Uuid
  setupScript   String?       @map("setup_script") @db.Text
  cpuLimit      String        @map("cpu_limit") @db.VarChar(20)
  memoryLimit   String        @map("memory_limit") @db.VarChar(20)
  diskSize      String        @map("disk_size") @db.VarChar(20)
  lastActiveAt  DateTime      @default(now()) @map("last_active_at") @db.Timestamp(6)
  startedAt     DateTime?     @map("started_at") @db.Timestamp(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sshIdentity   SshIdentity?          @relation(fields: [sshIdentityId], references: [id], onDelete: Restrict)
  conversations SandboxConversation[]
  members         SandboxMember[]
  promptAuthors   SandboxPromptAuthor[]
  sessionMessages SandboxSessionMessage[]
  shareLinks      SandboxShareLink[]
  projectLinks    SandboxProjectLink[]

  @@unique([userId, name])
  @@index([status, lastActiveAt], map: "idx_sandboxes_status_active")
  @@index([organizationId], map: "idx_sandboxes_organization")
  @@index([runner, status], map: "idx_sandboxes_runner_status")
  @@map("sandboxes")
  @@schema("ext_greenhouse")
}

model SandboxConversation {
  id                  String    @id @default(uuid()) @db.Uuid
  sandboxId           String    @map("sandbox_id") @db.Uuid
  title               String    @db.VarChar(120)
  repo                String?   @db.VarChar(120)
  claudeSessionId     String?   @map("claude_session_id") @db.VarChar(255)
  slug                String?   @db.VarChar(64)
  branch              String?   @db.VarChar(255)
  baseBranch          String?   @map("base_branch") @db.VarChar(255)
  baseCommit          String?   @map("base_commit") @db.VarChar(64)
  worktreePath        String?   @map("worktree_path") @db.VarChar(500)
  agent               String    @default("opencode") @db.VarChar(32)
  opencodeSessionId   String?   @map("opencode_session_id") @db.VarChar(255)
  prUrl               String?   @map("pr_url") @db.VarChar(500)
  prNumber            Int?      @map("pr_number")
  prState             String?   @map("pr_state") @db.VarChar(16)
  previewDeploymentId String?   @map("preview_deployment_id") @db.Uuid
  previewUrl          String?   @map("preview_url") @db.VarChar(500)
  previewEnvironmentId String?  @map("preview_environment_id") @db.Uuid
  createdById         String?   @map("created_by_id") @db.Uuid
  archivedAt          DateTime? @map("archived_at") @db.Timestamp(6)
  prepareError        String?   @map("prepare_error") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  sandbox   Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("SandboxSessionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments   SandboxSessionMessage[]
  slackThreadLinks SlackThreadLink[]
  shareLinks SandboxShareLink[]

  @@unique([sandboxId, slug], map: "uq_sandbox_conversations_sandbox_slug")
  @@index([sandboxId], map: "idx_sandbox_conversations_sandbox")
  @@index([sandboxId, archivedAt], map: "idx_sandbox_conversations_sandbox_archived")
  @@map("sandbox_conversations")
  @@schema("ext_greenhouse")
}

model SshIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  publicKey String   @map("public_key") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sandboxes Sandbox[]

  @@unique([userId, name])
  @@map("ssh_identities")
  @@schema("ext_greenhouse")
}

model SandboxCredential {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  claudeToken String?  @map("claude_token") @db.Text
  openaiToken String?  @map("openai_token") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sandbox_credentials")
  @@schema("ext_greenhouse")
}

enum SandboxMemberRole {
  viewer
  collaborator

  @@schema("public")
}

model SandboxMember {
  id          String            @id @default(uuid()) @db.Uuid
  sandboxId   String            @map("sandbox_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  role        SandboxMemberRole
  invitedById String?           @map("invited_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)

  sandbox   Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  user      User    @relation("SandboxMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("SandboxMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([sandboxId, userId], map: "uq_sandbox_members_sandbox_user")
  @@index([userId], map: "idx_sandbox_members_user")
  @@map("sandbox_members")
  @@schema("ext_greenhouse")
}

model SandboxPromptAuthor {
  id                String   @id @default(uuid()) @db.Uuid
  sandboxId         String   @map("sandbox_id") @db.Uuid
  sessionKey        String?  @map("session_id") @db.Uuid
  opencodeSessionId String   @map("opencode_session_id") @db.VarChar(64)
  messageId         String   @map("message_id") @db.VarChar(64)
  userId            String   @map("user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sandboxId, messageId], map: "uq_sandbox_prompt_authors_message")
  @@index([sandboxId, opencodeSessionId], map: "idx_sandbox_prompt_authors_chat")
  @@index([sessionKey], map: "idx_sandbox_prompt_authors_session")
  @@map("sandbox_prompt_authors")
  @@schema("ext_greenhouse")
}

model SandboxSessionMessage {
  id         String   @id @default(uuid()) @db.Uuid
  sandboxId  String   @map("sandbox_id") @db.Uuid
  sessionKey String   @map("session_id") @db.Uuid
  chatId     String   @map("chat_id") @db.VarChar(64)
  userId     String   @map("user_id") @db.Uuid
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  sandbox Sandbox             @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  session SandboxConversation @relation(fields: [sessionKey], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionKey, createdAt], map: "idx_sandbox_session_messages_session")
  @@index([sandboxId], map: "idx_sandbox_session_messages_sandbox")
  @@map("sandbox_session_messages")
  @@schema("ext_greenhouse")
}

model SandboxProjectLink {
  id            String   @id @default(uuid()) @db.Uuid
  sandboxId     String   @map("sandbox_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  environmentId String   @map("environment_id") @db.Uuid
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  sandbox     Sandbox     @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([sandboxId, projectId], map: "uq_sandbox_project_links_sandbox_project")
  @@index([environmentId], map: "idx_sandbox_project_links_environment")
  @@index([projectId], map: "idx_sandbox_project_links_project")
  @@map("sandbox_project_links")
  @@schema("ext_greenhouse")
}

model SandboxShareLink {
  id          String    @id @default(uuid()) @db.Uuid
  sandboxId   String    @map("sandbox_id") @db.Uuid
  sessionId   String?   @map("session_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  tokenHash   String    @unique(map: "uq_sandbox_share_links_token_hash") @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime? @map("expires_at") @db.Timestamp(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamp(6)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  sandbox   Sandbox              @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  session   SandboxConversation? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("SandboxShareLinkCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([sandboxId], map: "idx_sandbox_share_links_sandbox")
  @@index([sessionId], map: "idx_sandbox_share_links_session")
  @@map("sandbox_share_links")
  @@schema("ext_greenhouse")
}

model UserIntegration {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  provider      String   @db.VarChar(32)
  secret        String?  @db.Text
  externalId    String?  @map("external_id") @db.VarChar(255)
  workspaceName String?  @map("workspace_name") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider], map: "uq_user_integrations_user_provider")
  @@unique([provider, externalId], map: "uq_user_integrations_provider_external")
  @@map("user_integrations")
  @@schema("ext_greenhouse")
}

model SlackLinkToken {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique(map: "uq_slack_link_tokens_hash") @map("token_hash") @db.VarChar(64)
  teamId      String    @map("team_id") @db.VarChar(32)
  slackUserId String    @map("slack_user_id") @db.VarChar(32)
  slackUserName String? @map("slack_user_name") @db.VarChar(80)
  teamDomain  String?   @map("team_domain") @db.VarChar(80)
  expiresAt   DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt      DateTime? @map("used_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([teamId, slackUserId], map: "idx_slack_link_tokens_identity")
  @@index([expiresAt], map: "idx_slack_link_tokens_expires")
  @@map("slack_link_tokens")
  @@schema("ext_greenhouse")
}

model SandboxIntegrationDelivery {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String   @db.VarChar(32)
  deliveryId String   @map("delivery_id") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([provider, deliveryId], map: "uq_sandbox_integration_deliveries")
  @@index([createdAt], map: "idx_sandbox_integration_deliveries_created")
  @@map("sandbox_integration_deliveries")
  @@schema("ext_greenhouse")
}

model SlackThreadLink {
  id          String    @id @default(uuid()) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  sandboxId   String    @map("sandbox_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  channel     String    @db.VarChar(64)
  threadTs    String    @map("thread_ts") @db.VarChar(64)
  sawWorking  Boolean   @default(false) @map("saw_working")
  completedAt DateTime? @map("completed_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  session SandboxConversation @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([completedAt, createdAt], map: "idx_slack_thread_links_pending")
  @@index([sessionId], map: "idx_slack_thread_links_session")
  @@map("slack_thread_links")
  @@schema("ext_greenhouse")
}

model UserContextItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  kind      String   @db.VarChar(20)
  name      String   @db.VarChar(64)
  payload   String   @db.Text
  sizeBytes Int      @map("size_bytes")
  enabled   Boolean  @default(true)
  lock      String   @default("server") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, name])
  @@map("user_context_items")
  @@schema("ext_greenhouse")
}
