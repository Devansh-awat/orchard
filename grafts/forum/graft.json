{
  "id": "forum",
  "name": "The Grove",
  "version": "1.0.0",
  "publisher": "orchard",
  "description": "A forum for the people on your instance: bug reports, feature requests, votes and replies.",
  "homepage": "https://orchard.my/docs/run/grove",
  "engines": {
    "platform": ">=2.70.0 <3",
    "sdk": "^1.0.0"
  },
  "capabilities": ["db", "storage"],
  "database": {
    "coreReads": {
      "users": ["id", "username", "image_url"]
    },
    "adopts": ["forum_categories", "forum_threads", "forum_replies", "forum_votes"]
  },
  "ui": {
    "screens": [
      {
        "id": "board",
        "path": "/grove",
        "layout": "shell",
        "title": "The Grove"
      },
      {
        "id": "thread",
        "path": "/grove/:id",
        "layout": "shell",
        "title": "The Grove"
      }
    ]
  }
}
