# Dependencies - will be installed fresh in container
node_modules
**/node_modules

# Build outputs
**/dist
**/.next
**/build
!**/src/**/build
!**/src/**/build/**

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp
*.swo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment files (don't include secrets in build)
.env
.env.*
!.env.example

# Test files
**/__tests__
**/*.test.ts
**/*.spec.ts
**/coverage

# Documentation
*.md
!README.md

# Misc
.DS_Store
Thumbs.db
*.tgz
